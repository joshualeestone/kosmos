#!/bin/sh
#
# Kosmos installer package — postinstall (#546 / #555).
#
# macOS runs this as ROOT when the person double-clicks the .pkg and clicks
# Install. It does exactly what the published one-line install does — fetch
# the current installer and run it — but with NO Terminal, NO paste, and NO
# "Possible Malware, Paste Blocked" dialog, because macOS opened its own
# verified-developer Installer for a signed, notarised package.
#
# Two properties this preserves from `curl -fsSL https://installkosmos.com/setup | sh`:
#
#   1. NEVER STALE. The package carries no app of its own; it fetches the
#      CURRENT installer at install time, which fetches the current bundle.
#      So the .pkg on the download page can never serve an old Kosmos.
#   2. USER-LEVEL. install/setup.sh installs into the person's home and their
#      own launchd session, with no sudo. A pkg postinstall runs as root, so
#      we must drop to the CONSOLE USER (the person clicking) and run inside
#      their GUI session, or the board's user LaunchAgent cannot be loaded and
#      the files land under the wrong owner.
#
set -u

# What the paste command fetches. Overridable for the clean-machine harness
# and for testing against a local server; defaults to the real site.
SETUP_URL="${KOSMOS_SETUP_URL:-https://installkosmos.com/setup}"

# WHO to install for. NOT `stat -f '%Su' /dev/console` -- that is the PHYSICAL
# console holder, which is the wrong user (or none) the moment a Mac has a second
# account with a session: fast user switching, a second admin account, or Screen
# Sharing into a virtual session (kosmos#1880). resolve_install_user finds the
# owner of the running GUI Installer -- the person who actually invoked this --
# confirms they hold a real Aqua GUI session, and only falls back to the console
# user. On failure it explains WHICH check failed instead of the flat, and
# sometimes flatly wrong, "no one is signed in". Downstream keeps using
# CONSOLE_USER / CONSOLE_UID, so only their SOURCE changes here.
_riu_lib="$(dirname "$0")/resolve-install-user.sh"
if [ ! -f "$_riu_lib" ]; then
  echo "Kosmos: this installer is incomplete (resolve-install-user.sh missing)." >&2
  exit 1
fi
. "$_riu_lib"
if ! resolve_install_user; then
  echo "$RIU_REASON" >&2
  exit 1
fi
CONSOLE_USER="$INSTALL_USER"
CONSOLE_UID="$INSTALL_UID"

# ---- Show life FIRST (#662 / #663). Installer's own progress bar cannot be
# moved by a package script: it sits still for the whole download, and a bar
# that does not move reads as dead no matter what a welcome pane promised
# (Josh counted 36 seconds and concluded it was broken, twice). So before the
# install starts, open a page in the person's browser that shows a spinner,
# counts, and becomes the dashboard the moment the board answers. It is
# opened through a one-shot LaunchAgent in the person's gui session, the one
# mechanism Apple supports for an installer reaching the desktop; a bare
# /usr/bin/open from this root context is not that session (#663's bug).
# Best-effort: if any step fails the install proceeds exactly as before and
# setup.sh keeps its own conclusion-time open.
PAGE_OPENED=0
USER_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
[ -n "$USER_HOME" ] || USER_HOME="/Users/$CONSOLE_USER"
PAGE_SRC="$(dirname "$0")/installing.html"
PAGE_DIR="$USER_HOME/Library/Caches/Kosmos"
PAGE="$PAGE_DIR/installing.html"
AGENT_LABEL=com.kosmos.installing
AGENT_PLIST="$USER_HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
# 🔑 #910: THE SAME PER-ACCOUNT PORT setup.sh WILL DERIVE FOR THIS CONSOLE
# USER, computed here (root already knows $CONSOLE_UID) and threaded into
# the page below as an explicit argument -- NOT left to the inner
# subshell's own `${KOSMOS_PORT:-16180}`, which is not exported anywhere
# in this root-descended path and would always bake the literal primary
# port regardless of which account is installing. For any account other
# than the primary (uid 501), the real board setup.sh starts a few lines
# down binds its OWN, correctly-derived, DIFFERENT port -- so a page baked
# with 16180 would poll a port nothing ever answers on, and the "becomes
# the dashboard the moment the board answers" promise this whole page
# exists for would just never happen for exactly the account this card is
# about. Same formula as install/kosmos, install/setup.sh, and
# native-app/main.swift, must move together (now four sites, not three).
_kosmos_port_ok=0
if [ -n "${KOSMOS_PORT:-}" ]; then
  # Same digit-only/length/range posture as install/setup.sh's own
  # KOSMOS_PORT guard, for the same reason: this value is baked into the
  # generated page via `sed`, so anything but plain digits could corrupt
  # the sed command itself (a `/` or `&` in KOSMOS_PORT) or bake a
  # malformed value into the page.
  # 🛑 FALL BACK, NEVER exit, on a bad value here. This section is
  # documented above as best-effort ("if any step fails the install
  # proceeds exactly as before"), and `sudo` does not carry this
  # postinstall's own environment into the real install at the bottom of
  # this file (line ~139) -- so KOSMOS_PORT here affects ONLY the cosmetic
  # progress page, never the actual board's port. An `exit` on a malformed
  # value would abort the REAL install too, which is strictly worse than a
  # cosmetic page guessing wrong. Caught in review: the first version of
  # this guard did exactly that.
  case "$KOSMOS_PORT" in
    ''|*[!0-9]*|0*|??????*) ;;
    *) [ "$KOSMOS_PORT" -le 65535 ] && _kosmos_port_ok=1 ;;
  esac
fi
if [ "$_kosmos_port_ok" = 1 ]; then
  _KOSMOS_PAGE_PORT="$KOSMOS_PORT"
elif [ "$CONSOLE_UID" = 501 ]; then
  _KOSMOS_PAGE_PORT=16180
else
  _KOSMOS_PAGE_PORT=$((16180 + 1 + (CONSOLE_UID % 3999)))
fi
if [ -f "$PAGE_SRC" ] && [ -d "$USER_HOME" ]; then
  # kosmos#3268: installing.html (PAGE_SRC) lives in the root-owned PKInstallSandbox
  # Scripts dir. The render below drops to the console user (sudo -u) to reach their
  # gui launchd session, but the console user cannot READ a root-owned Scripts file,
  # so `sed "$0"` fails, the inner `set -e` aborts the sub-shell, and the progress
  # page never opens ("install page opened=0" -- the #3233 download bar is missing on
  # the .pkg path). Stage a world-readable copy AS ROOT first and render from it. Use
  # an explicit /tmp path, NOT mktemp's default dir: under installd $TMPDIR is that
  # same root-owned sandbox, so a temp there would be unreadable too. Fall back to the
  # original on any copy failure (no worse than before this fix). The page is static
  # public content, so a world-readable copy leaks nothing.
  _PAGE_READABLE="$PAGE_SRC"
  _pr_tmp="$(/usr/bin/mktemp /tmp/kosmos-installing.XXXXXX 2>/dev/null || true)"
  if [ -n "$_pr_tmp" ] && /bin/cp "$PAGE_SRC" "$_pr_tmp" 2>/dev/null && /bin/chmod 644 "$_pr_tmp" 2>/dev/null; then
    _PAGE_READABLE="$_pr_tmp"
  fi
  # kosmos#3268: also clean the staged copy on any exit path, not only via the explicit rm
  # below -- matches the trap in the setup.sh-invoking block later in THIS file (~line 199,
  # not install/setup.sh). EXIT-only, so it does not
  # change the postinstall's signal handling; a hard SIGKILL/SIGTERM (e.g. cancelling the
  # Installer mid-render) can still leak the one small world-readable /tmp page, the same
  # inherent limit as that trap, and macOS purges /tmp.
  trap '[ -n "$_pr_tmp" ] && /bin/rm -f "$_pr_tmp" 2>/dev/null' EXIT
  /usr/bin/sudo -u "$CONSOLE_USER" -H /bin/sh -c '
    set -e
    mkdir -p "$1" "$(dirname "$3")"
    # kosmos#3233: clear any stale install-progress.js from a previous run so this
    # fresh page reads "no data" (its swoosh) until the current setup.sh writes live
    # bytes, rather than briefly rendering a leftover percentage (e.g. an old 100%).
    rm -f "$1/install-progress.js" 2>/dev/null || true
    sed "s/__KOSMOS_PORT__/$5/" "$0" > "$2"
    /bin/launchctl bootout "gui/$(/usr/bin/id -u)/$4" >/dev/null 2>&1 || true
    cat > "$3" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$4</string>
  <key>RunAtLoad</key><true/>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/usr/bin/open "\$0"; rm -f "\$1"; /bin/launchctl bootout "gui/\$(/usr/bin/id -u)/$4"</string>
    <string>$2</string>
    <string>$3</string>
  </array>
</dict>
</plist>
PLIST
  ' "$_PAGE_READABLE" "$PAGE_DIR" "$PAGE" "$AGENT_PLIST" "$AGENT_LABEL" "$_KOSMOS_PAGE_PORT" \
  && /bin/launchctl bootstrap "gui/$CONSOLE_UID" "$AGENT_PLIST" 2>/dev/null \
  && PAGE_OPENED=1
  # kosmos#3268: remove the staged readable copy (set only when mktemp succeeded;
  # a failed cp/chmod still leaves the empty temp, so remove it unconditionally here).
  [ -n "$_pr_tmp" ] && /bin/rm -f "$_pr_tmp" 2>/dev/null || true
  # kosmos#3268: the temp is gone now, so disarm the EXIT trap rather than leave it live
  # through the long real-install block below (it would only re-rm an already-removed path).
  trap - EXIT
fi
echo "Kosmos: install page opened=$PAGE_OPENED"

# ---- kosmos#6576: the install is held to the SIGNED release before anything downloaded runs. An installed copy
# checks every update with its own verifier (#6468), but a Mac with no Kosmos has none, and an older or damaged
# install may not have a working one, so this package carries its own: kosmos-pkg-verify, signed with the Developer
# ID Application identity and covered by this package's notarization, with the release public keys built in. It runs
# HERE, as root, because the Scripts dir is readable by root only (#3268), and it runs for every install, existing
# or not: an installed copy still makes its own checks inside setup.sh as well. The installer, the release manifest
# and its signature are downloaded into a root-owned folder the person can read but not write; the helper checks the
# signature, that it is the version the site offers and not older than the oldest release this package accepts
# (kosmos-pkg-floor), and the installer must match the signed setup_sha256. The person's shell below then runs THAT
# file, with the signed version and the signed sha256 of the Kosmos and tmux downloads, which setup.sh installs and
# holds them to (pinned_sha_ok). Anything that does not check out ends the install here: nothing downloaded has run.
PIN_SETUP=""; PIN_VERSION=""; PIN_TARBALL=""; PIN_TMUX=""
_pin_helper="$(dirname "$0")/kosmos-pkg-verify"
_pin_floor="$(/bin/cat "$(dirname "$0")/kosmos-pkg-floor" 2>/dev/null || true)"
# SWITCHED OFF while kosmos-pkg-floor reads "off" (install/pkg-verify/floor): until production serves a signed
# release, its pointer names one with no signature and every install would refuse. Setting the floor to the first
# signed release (0.7.57) turns this on; nothing else changes.
if [ "$_pin_floor" = off ]; then
  echo "Kosmos: the signed-release check is not switched on in this installer yet"
else
  if [ ! -x "$_pin_helper" ] || [ -z "$_pin_floor" ]; then
    echo "Kosmos: this installer is incomplete (its release check is missing), so nothing was installed." >&2
    exit 1
  fi
  _pin_dir="$(/usr/bin/mktemp -d /tmp/kosmos-pkgpin.XXXXXX)" || { echo "Kosmos: could not prepare the install, so nothing was installed." >&2; exit 1; }
  trap '/bin/rm -rf "$_pin_dir"' EXIT
  /bin/chmod 755 "$_pin_dir"
  _pin_base="${SETUP_URL%/*}/dist"
  # The same cache-buster setup.sh uses for its pointer read, on an http(s) site only (a file:// path has no cache,
  # and a query there names a missing file).
  _pin_bust=""
  case "$_pin_base" in http://*|https://*) _pin_bust="?nocache=$$" ;; esac
  _pin_n=0; _pin_out=""; _pin_why=""
  while :; do
    _pin_n=$((_pin_n + 1))
    _pin_why=unreachable
    _pin_v="$(/usr/bin/curl -fsSL --connect-timeout 20 -m 60 "$_pin_base/latest.json$_pin_bust" 2>/dev/null \
      | /usr/bin/sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | /usr/bin/head -1)" || _pin_v=""
    # Only an a.b.c goes into a download address; anything else is a pointer caught mid-deploy, retried as a failed download.
    case "$_pin_v" in *[!0-9.]*|.*|*.|*..*|*.*.*.*) _pin_v="" ;; *.*.*) ;; *) _pin_v="" ;; esac
    if [ -n "$_pin_v" ] \
       && /usr/bin/curl -fsSL --connect-timeout 20 -m 60 -o "$_pin_dir/manifest.json" "$_pin_base/kosmos-$_pin_v-arm64.manifest.json$_pin_bust" \
       && /usr/bin/curl -fsSL --connect-timeout 20 -m 60 -o "$_pin_dir/manifest.sig" "$_pin_base/kosmos-$_pin_v-arm64.manifest.json.sig$_pin_bust" \
       && /usr/bin/curl -fsSL --connect-timeout 20 -m 300 -o "$_pin_dir/setup" "$SETUP_URL$_pin_bust"; then
      # #6609: the release key list, from beside the manifest. Never required here: the helper decides. With no
      # recovery key built in it does not read the list; with one, a list that is missing refuses (97), rechecked below.
      if ! /usr/bin/curl -fsSL --connect-timeout 20 -m 60 -o "$_pin_dir/release-keys.json" "$_pin_base/release-keys.json$_pin_bust" 2>/dev/null \
         || ! /usr/bin/curl -fsSL --connect-timeout 20 -m 60 -o "$_pin_dir/release-keys.json.sig" "$_pin_base/release-keys.json.sig$_pin_bust" 2>/dev/null; then
        /bin/rm -f "$_pin_dir/release-keys.json" "$_pin_dir/release-keys.json.sig"
      fi
      _pin_rc=0
      _pin_out="$("$_pin_helper" "$_pin_dir/manifest.json" "$_pin_dir/manifest.sig" "$_pin_v" "$_pin_floor" \
        "$_pin_dir/release-keys.json" "$_pin_dir/release-keys.json.sig")" || _pin_rc=$?
      # 97 is the helper refusing the release, rechecked below; any other failure (a bad argument, a crash, a refused
      # launch) means the check itself could not run, and ends the install now.
      if [ "$_pin_rc" -ne 0 ] && [ "$_pin_rc" -ne 97 ]; then
        echo "Kosmos: this installer could not run its release check (status $_pin_rc), so nothing was installed." >&2
        exit 1
      fi
      PIN_TARBALL="$(printf '%s\n' "$_pin_out" | /usr/bin/sed -n 's/^sha256=//p')"
      PIN_TMUX="$(printf '%s\n' "$_pin_out" | /usr/bin/sed -n 's/^tmux_sha256=//p')"
      _pin_setup_want="$(printf '%s\n' "$_pin_out" | /usr/bin/sed -n 's/^setup_sha256=//p')"
      _pin_setup_got="$(/usr/bin/shasum -a 256 "$_pin_dir/setup" | /usr/bin/awk '{print $1}')"
      # A mismatch can be a deploy caught half way (the installer and the release published a moment apart), so it is
      # rechecked on the same budget as a failed download, as the checksum path below does; one that persists refuses.
      if [ "$_pin_rc" -eq 0 ] && [ -n "$_pin_setup_want" ] && [ "$_pin_setup_want" = "$_pin_setup_got" ] && [ -n "$PIN_TARBALL" ] && [ -n "$PIN_TMUX" ]; then
        break
      fi
      # A refused release (97) is rechecked like a mismatch: a deploy caught half way can serve a manifest and a
      # signature that do not belong together for a moment. One that persists through the budget refuses.
      if [ "$_pin_rc" -eq 97 ]; then _pin_why=refused; else _pin_why=mismatch; fi
    fi
    if [ "$_pin_n" -ge 5 ]; then
      if [ "$_pin_why" = refused ]; then
        echo "Kosmos: the download did not check out against the signed Kosmos release (the line above says why), so nothing was installed." >&2
        exit 97
      fi
      if [ "$_pin_why" = mismatch ]; then
        echo "Kosmos: the installer does not match its signed release, so it was NOT run and nothing was installed." >&2
        exit 97
      fi
      echo "Kosmos: the installer or its signed release could not be downloaded, or updates are paused for now, so nothing was installed. It is safe to try again shortly." >&2
      exit 96
    fi
    _pin_sleep="${KOSMOS_PKG_RETRY_SLEEP:-3}"
    case "$_pin_sleep" in ""|*[!0-9]*) _pin_sleep=3 ;; esac
    [ "$_pin_sleep" -le 10 ] || _pin_sleep=10
    /bin/sleep "$_pin_sleep"
  done
  # The pins mean something only to an installer that honours them. One that predates them would install the Kosmos
  # and tmux downloads unchecked, so its signed bytes must carry the line that says it does (grepped AFTER its sha256
  # matched the signed release, so the line is part of what was signed). A floor set too low fails closed here.
  if ! /usr/bin/grep -qx "# kosmos-pkg-pins: honored" "$_pin_dir/setup"; then
    echo "Kosmos: the release offered ($_pin_v) is signed, but its installer cannot hold the downloads to it, so nothing was installed." >&2
    exit 97
  fi
  /bin/chmod 644 "$_pin_dir/setup"
  PIN_SETUP="$_pin_dir/setup"
  PIN_VERSION="$_pin_v"
  echo "Kosmos: the installer matches signed release $_pin_v"
fi

# Run the current installer as that user, inside their Aqua/GUI launchd
# session. `launchctl asuser` supplies the session (so `launchctl bootstrap
# gui/<uid>` in setup.sh works); `sudo -u -H` drops from root to the user and
# sets HOME. The URL is passed as $0 so the pipe stays inside the user shell.
#
# KOSMOS_INSTALL_VIA=pkg tells setup.sh it is running under Installer: its
# stdout is swallowed (Installer keeps it in /var/log/install.log, which is
# where to look when a run is disputed), and a bare /usr/bin/open from this
# root-descended shell is not a reliable way to reach the person's browser
# (#663: the first real fresh-account run printed "Opening your dashboard"
# and nothing opened). setup.sh opens through the person's own gui launchd
# session instead when it sees this. Set INSIDE the user shell: sudo does
# not carry the caller's environment across.
/bin/launchctl asuser "$CONSOLE_UID" \
  /usr/bin/sudo -u "$CONSOLE_USER" -H /bin/sh -c \
  'KOSMOS_INSTALL_VIA=pkg; KOSMOS_INSTALL_PAGE="$1"; export KOSMOS_INSTALL_VIA KOSMOS_INSTALL_PAGE
   # kosmos#1670: VERIFY BEFORE RUNNING. The pkg is the one install path with a
   # real trust anchor -- it carries a stapled Apple notarisation ticket, so it
   # reached this machine through a channel independent of the HTTPS fetch it is
   # about to perform. It was also the least verified path: nothing machine-side
   # read setup.sha256, which is why a published checksum that did not match the
   # served bytes survived a whole day (#1666).
   #
   # THE TERMINAL PATH CANNOT DO THIS AND THIS IS NOT AN ATTEMPT TO FIX IT.
   # `curl | sh` would have to fetch the thing to check the thing, over the same
   # channel, so it has no independent anchor. Only the pkg does.
   set -e
   d=$(/usr/bin/mktemp -d) || exit 1
   trap "/bin/rm -rf \"$d\"" EXIT
   # kosmos#6576: a first install was checked against the signed release above, as root. Run THAT installer, and hold
   # the Kosmos and tmux downloads, and the version installed, to the signed values (setup.sh). Nothing is downloaded here.
   if [ -n "$2" ]; then
     /bin/cp "$2" "$d/setup" || exit 1
     KOSMOS_PINNED_TARBALL_SHA256="$3"; KOSMOS_PINNED_TMUX_SHA256="$4"; KOSMOS_PINNED_VERSION="$5"
     export KOSMOS_PINNED_TARBALL_SHA256 KOSMOS_PINNED_TMUX_SHA256 KOSMOS_PINNED_VERSION
     /bin/sh "$d/setup"
     exit $?
   fi
   # AN UNREACHABLE CHECKSUM REFUSES TOO, AND THAT IS DELIBERATE. The threat this
   # guards is a MISCONFIGURED origin, not a malicious one: an origin that can
   # serve you bad bytes can serve you a matching checksum, so the guard buys
   # nothing against that. What it does buy is protection against a HALF-PUBLISHED
   # site -- and a missing .sha256 is a symptom of exactly that state, not an
   # unrelated blip. Proceeding without the anchor would make this path no better
   # than the terminal one, which is the whole argument for the card.
   #
   # BOUNDED RETRY (2026-09-15 installer P0 hardening). The gate above is correct
   # to refuse a half-published site, but a production deploy can briefly present a
   # mismatched (setup, setup.sha256) pair -- or a not-yet-propagated .sha256 -- at
   # the CDN edge while a swap propagates, and a SINGLE-SHOT check turns that
   # transient window into a hard "installation failed". So we re-fetch a few times
   # with a short pause: a transient inconsistency resolves within seconds, while a
   # PERSISTENT mismatch or a persistently-missing checksum (real corruption, or a
   # genuinely misconfigured origin) STILL refuses after the retries. The #1670
   # threat model is unchanged -- a persistent bad/half-published state is fail-closed;
   # only a self-resolving transient is tolerated. This pairs with the publish-side
   # atomic-verify (a deploy should not create the window in the first place).
   # Retry budget. Defaults 5 attempts / 3s pause (~12s of pauses worst case, a
   # named-wait the Installer bar already covers). KOSMOS_PKG_RETRY_MAX/_SLEEP let
   # the test drive the loop fast; they do NOT reach here in production because the
   # `sudo -u -H` above resets the environment (only KOSMOS_INSTALL_VIA/_PAGE are
   # re-exported), so a real install always uses the defaults. Digit-sanitised AND
   # CEILING-CLAMPED so even a manual (non-default-sudoers) invocation with an absurd
   # value can neither break the arithmetic, nor skip the verification, nor hang: a
   # non-numeric value falls back to the default, and a numeric one is capped (max 10
   # attempts, max 10s pause -> ~100s absolute worst case). The clamp also removes a
   # `set -e` foot-gun: `/bin/sleep "$_rsleep"` is the unguarded last statement in the
   # loop, so a value the sleep binary itself rejects (e.g. 10000000000) would abort
   # the script with a raw sleep-usage error instead of a Kosmos refusal; a clamped
   # value is always a legal sleep argument.
   # 🛑 EMPTY PATTERN MUST BE "" (two double-quotes), NOT a pair of single-quotes, HERE
   # (kosmos, 0.6.77 installer P0). This whole block is a single-quoted /bin/sh -c
   # argument, so a literal pair of single-quotes is read by the OUTER shell as
   # close-quote + open-quote and VANISHES from the string the inner sh gets, leaving
   # `case "$_rmax" in |*[!0-9]*)` = "syntax error near |" -> the install aborts. ""
   # is literal inside the outer single-quotes, passes through, and matches empty the
   # same. A file-level `sh -n` does NOT catch it (the pair looks balanced); it only
   # breaks when the outer shell builds the -c arg at install time. Do NOT change ""
   # back to a single-quote pair. And keep this WHOLE block apostrophe-free: a stray
   # lone single-quote (an apostrophe, as in the contraction of "do not") makes an ODD
   # count and unbalances the outer quoting -- the same P0 class, one edit away.
   _rmax=${KOSMOS_PKG_RETRY_MAX:-5}; _rsleep=${KOSMOS_PKG_RETRY_SLEEP:-3}
   case "$_rmax" in ""|*[!0-9]*) _rmax=5;; esac
   case "$_rsleep" in ""|*[!0-9]*) _rsleep=3;; esac
   [ "$_rmax" -ge 1 ] || _rmax=5
   [ "$_rmax" -le 10 ] || _rmax=10
   [ "$_rsleep" -le 10 ] || _rsleep=10
   n=0; _why=""
   while :; do
     n=$((n + 1))
     if /usr/bin/curl -fsSL -o "$d/setup" "$0" \
        && /usr/bin/curl -fsSL -o "$d/sum" "$0.sha256"; then
       want=$(/usr/bin/awk "{print \$1; exit}" "$d/sum")
       got=$(/usr/bin/shasum -a 256 "$d/setup" | /usr/bin/awk "{print \$1}")
       if [ -n "$want" ] && [ "$want" = "$got" ]; then
         break
       fi
       _why=mismatch
     else
       _why=unreachable
     fi
     if [ "$n" -ge "$_rmax" ]; then
       if [ "$_why" = unreachable ]; then
         echo "Kosmos: could not download the installer or its published checksum, so nothing was run." >&2
         echo "Nothing was installed. This usually means the download site is mid-update; it is safe to try again shortly." >&2
       else
         echo "Kosmos: the installer did not match its published checksum after rechecking for several seconds, so it was NOT run." >&2
         echo "Nothing was installed. Please report this rather than retrying: a mismatch that persists this long does not fix itself." >&2
       fi
       exit 1
     fi
     /bin/sleep "$_rsleep"
   done
   # kosmos#4319: RUN setup, NOT exec it. exec replaced this shell, so the EXIT trap above never
   # fired and every install left this directory (the installer and its checksum) in the temp
   # dir of the person. As the last command, the status of setup is the exit status of this
   # shell, and the trap removes the directory without changing that status.
   # A signal sent to this shell alone (not its process group) now ends this shell and not
   # setup, which runs on from its open file. Nothing in a normal install does that.
   # kosmos#6474: AN EXISTING INSTALL HOLDS THE INSTALLER TO ITS SIGNED RELEASE, as an in-app update does (#6468).
   # When this user already has Kosmos at the default home and its verifier knows run-setup, that installed copy
   # downloads the installer and the signed manifest of the version prod serves, checks one against the other, and
   # only then runs it. While the #6576 check is switched off, a first install has no installed copy to check with, so it
   # keeps the checksum above; switched on, every package install takes the pinned path above and never reaches this. Keep this block
   # free of apostrophes: it is inside the single-quoted argument above.
   h="$HOME/.local/share/kosmos"
   # The checksum gate above still runs first, on purpose: an existing install is held to BOTH (the hand-off downloads
   # the installer again and checks it against the signed release). Conservative, not an oversight.
   # (Not on the #6576 pinned path above, which runs the checked installer directly and ends before this: there
   # setup.sh still runs the installed verifier, which refuses a release older than the installed one.)
   # (Measured in review 4: a pattern match let a half-written package.json and a truncated verifier through, so the
   # installed node itself parses the one and syntax-checks the other: the same tests the hand-off needs to work.)
   # The installed node must RUN and the installed version must READ (a broken install being repaired keeps the
   # checksum path: no weaker than a first install). run-setup answers 96 when a download failed, which a retry can
   # fix (a half-published deploy), so 96 is retried on the same bounded budget as the checksum above; 97 means it
   # was refused (the installer or its manifest did not check out, or this Mac already has a NEWER Kosmos than the
   # site offers), which a retry cannot change, so it ends here with one sentence. Any other status is the answer.
   if [ -f "$h/app/engine/manifest-verify.js" ] && [ -f "$h/runtime/bin/node" ] && [ -x "$h/runtime/bin/node" ] \
      && /usr/bin/grep -q run-setup "$h/app/engine/manifest-verify.js" \
      && "$h/runtime/bin/node" --check "$h/app/engine/manifest-verify.js" >/dev/null 2>&1 \
      && "$h/runtime/bin/node" -e "process.exit(/^[0-9]+[.][0-9]+[.][0-9]+\$/.test(String(JSON.parse(require(\"fs\").readFileSync(process.argv[1], \"utf8\")).version)) ? 0 : 1)" "$h/app/package.json" >/dev/null 2>&1; then
     base="${0%/*}/dist"
     n=0
     while :; do
       n=$((n + 1))
       v=$(/usr/bin/curl -fsSL --connect-timeout 20 -m 60 "$base/latest.json" 2>/dev/null | /usr/bin/sed -n "s/.*\"version\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | /usr/bin/head -1) || v=""
       # An unreadable pointer is a failed download too (96), never a refusal: a blip must not end the install.
       if [ -z "$v" ]; then src=96
       else src=0; "$h/runtime/bin/node" "$h/app/engine/manifest-verify.js" run-setup "$0" "$base" "$v" "$h" || src=$?; fi
       if [ "$src" -eq 97 ]; then
         echo "Kosmos: this Mac already has Kosmos, and its own check refused this installer (the line above says why), so nothing was changed. If it says this Mac is newer than the version offered, there is nothing to repair." >&2
         exit 97
       fi
       [ "$src" -eq 96 ] || exit "$src"
       if [ "$n" -ge "$_rmax" ]; then
         echo "Kosmos: the installer or its signed release could not be downloaded, or updates are paused for now, so nothing was changed. It is safe to try again shortly." >&2
         exit 96
       fi
       /bin/sleep "$_rsleep"
     done
   fi
   /bin/sh "$d/setup"' "$SETUP_URL" "$PAGE_OPENED" "$PIN_SETUP" "$PIN_TARBALL" "$PIN_TMUX" "$PIN_VERSION"
rc=$?

if [ "$rc" -ne 0 ]; then
  echo "Kosmos: the install did not complete (exit $rc)." >&2
  exit "$rc"
fi
exit 0
