#!/bin/sh
#
# Kosmos installer package — postinstall (#546 / #555).
#
# macOS runs this as ROOT when the person double-clicks the .pkg and clicks
# Install. It does exactly what the published one-line install does — fetch
# the current installer and run it — but with NO Terminal, NO paste, and NO
# "Possible Malware, Paste Blocked" dialog, because macOS opened its own
# verified-developer Installer for a signed, notarised package.
#
# Two properties this preserves from `curl -fsSL https://installkosmos.com/setup | sh`:
#
#   1. NEVER STALE. The package carries no app of its own; it fetches the
#      CURRENT installer at install time, which fetches the current bundle.
#      So the .pkg on the download page can never serve an old Kosmos.
#   2. USER-LEVEL. install/setup.sh installs into the person's home and their
#      own launchd session, with no sudo. A pkg postinstall runs as root, so
#      we must drop to the CONSOLE USER (the person clicking) and run inside
#      their GUI session, or the board's user LaunchAgent cannot be loaded and
#      the files land under the wrong owner.
#
set -u

# What the paste command fetches. Overridable for the clean-machine harness
# and for testing against a local server; defaults to the real site.
SETUP_URL="${KOSMOS_SETUP_URL:-https://installkosmos.com/setup}"

# The person double-clicking is the console user, not root.
CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "loginwindow" ]; then
  echo "Kosmos: no one is signed in to install for. Sign in, then open this again." >&2
  exit 1
fi
CONSOLE_UID="$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null)"
if [ -z "$CONSOLE_UID" ]; then
  echo "Kosmos: could not resolve the signed-in user." >&2
  exit 1
fi

# ---- Show life FIRST (#662 / #663). Installer's own progress bar cannot be
# moved by a package script: it sits still for the whole download, and a bar
# that does not move reads as dead no matter what a welcome pane promised
# (Josh counted 36 seconds and concluded it was broken, twice). So before the
# install starts, open a page in the person's browser that shows a spinner,
# counts, and becomes the dashboard the moment the board answers. It is
# opened through a one-shot LaunchAgent in the person's gui session, the one
# mechanism Apple supports for an installer reaching the desktop; a bare
# /usr/bin/open from this root context is not that session (#663's bug).
# Best-effort: if any step fails the install proceeds exactly as before and
# setup.sh keeps its own conclusion-time open.
PAGE_OPENED=0
USER_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
[ -n "$USER_HOME" ] || USER_HOME="/Users/$CONSOLE_USER"
PAGE_SRC="$(dirname "$0")/installing.html"
PAGE_DIR="$USER_HOME/Library/Caches/Kosmos"
PAGE="$PAGE_DIR/installing.html"
AGENT_LABEL=com.kosmos.installing
AGENT_PLIST="$USER_HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
# 🔑 #910: THE SAME PER-ACCOUNT PORT setup.sh WILL DERIVE FOR THIS CONSOLE
# USER, computed here (root already knows $CONSOLE_UID) and threaded into
# the page below as an explicit argument -- NOT left to the inner
# subshell's own `${KOSMOS_PORT:-16180}`, which is not exported anywhere
# in this root-descended path and would always bake the literal primary
# port regardless of which account is installing. For any account other
# than the primary (uid 501), the real board setup.sh starts a few lines
# down binds its OWN, correctly-derived, DIFFERENT port -- so a page baked
# with 16180 would poll a port nothing ever answers on, and the "becomes
# the dashboard the moment the board answers" promise this whole page
# exists for would just never happen for exactly the account this card is
# about. Same formula as install/kosmos, install/setup.sh, and
# native-app/main.swift, must move together (now four sites, not three).
_kosmos_port_ok=0
if [ -n "${KOSMOS_PORT:-}" ]; then
  # Same digit-only/length/range posture as install/setup.sh's own
  # KOSMOS_PORT guard, for the same reason: this value is baked into the
  # generated page via `sed`, so anything but plain digits could corrupt
  # the sed command itself (a `/` or `&` in KOSMOS_PORT) or bake a
  # malformed value into the page.
  # 🛑 FALL BACK, NEVER exit, on a bad value here. This section is
  # documented above as best-effort ("if any step fails the install
  # proceeds exactly as before"), and `sudo` does not carry this
  # postinstall's own environment into the real install at the bottom of
  # this file (line ~139) -- so KOSMOS_PORT here affects ONLY the cosmetic
  # progress page, never the actual board's port. An `exit` on a malformed
  # value would abort the REAL install too, which is strictly worse than a
  # cosmetic page guessing wrong. Caught in review: the first version of
  # this guard did exactly that.
  case "$KOSMOS_PORT" in
    ''|*[!0-9]*|0*|??????*) ;;
    *) [ "$KOSMOS_PORT" -le 65535 ] && _kosmos_port_ok=1 ;;
  esac
fi
if [ "$_kosmos_port_ok" = 1 ]; then
  _KOSMOS_PAGE_PORT="$KOSMOS_PORT"
elif [ "$CONSOLE_UID" = 501 ]; then
  _KOSMOS_PAGE_PORT=16180
else
  _KOSMOS_PAGE_PORT=$((16180 + 1 + (CONSOLE_UID % 3999)))
fi
if [ -f "$PAGE_SRC" ] && [ -d "$USER_HOME" ]; then
  /usr/bin/sudo -u "$CONSOLE_USER" -H /bin/sh -c '
    set -e
    mkdir -p "$1" "$(dirname "$3")"
    sed "s/__KOSMOS_PORT__/$5/" "$0" > "$2"
    /bin/launchctl bootout "gui/$(/usr/bin/id -u)/$4" >/dev/null 2>&1 || true
    cat > "$3" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$4</string>
  <key>RunAtLoad</key><true/>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/usr/bin/open "\$0"; rm -f "\$1"; /bin/launchctl bootout "gui/\$(/usr/bin/id -u)/$4"</string>
    <string>$2</string>
    <string>$3</string>
  </array>
</dict>
</plist>
PLIST
  ' "$PAGE_SRC" "$PAGE_DIR" "$PAGE" "$AGENT_PLIST" "$AGENT_LABEL" "$_KOSMOS_PAGE_PORT" \
  && /bin/launchctl bootstrap "gui/$CONSOLE_UID" "$AGENT_PLIST" 2>/dev/null \
  && PAGE_OPENED=1
fi
echo "Kosmos: install page opened=$PAGE_OPENED"

# Run the current installer as that user, inside their Aqua/GUI launchd
# session. `launchctl asuser` supplies the session (so `launchctl bootstrap
# gui/<uid>` in setup.sh works); `sudo -u -H` drops from root to the user and
# sets HOME. The URL is passed as $0 so the pipe stays inside the user shell.
#
# KOSMOS_INSTALL_VIA=pkg tells setup.sh it is running under Installer: its
# stdout is swallowed (Installer keeps it in /var/log/install.log, which is
# where to look when a run is disputed), and a bare /usr/bin/open from this
# root-descended shell is not a reliable way to reach the person's browser
# (#663: the first real fresh-account run printed "Opening your dashboard"
# and nothing opened). setup.sh opens through the person's own gui launchd
# session instead when it sees this. Set INSIDE the user shell: sudo does
# not carry the caller's environment across.
/bin/launchctl asuser "$CONSOLE_UID" \
  /usr/bin/sudo -u "$CONSOLE_USER" -H /bin/sh -c \
  'KOSMOS_INSTALL_VIA=pkg; KOSMOS_INSTALL_PAGE="$1"; export KOSMOS_INSTALL_VIA KOSMOS_INSTALL_PAGE
   # kosmos#1670: VERIFY BEFORE RUNNING. The pkg is the one install path with a
   # real trust anchor -- it carries a stapled Apple notarisation ticket, so it
   # reached this machine through a channel independent of the HTTPS fetch it is
   # about to perform. It was also the least verified path: nothing machine-side
   # read setup.sha256, which is why a published checksum that did not match the
   # served bytes survived a whole day (#1666).
   #
   # THE TERMINAL PATH CANNOT DO THIS AND THIS IS NOT AN ATTEMPT TO FIX IT.
   # `curl | sh` would have to fetch the thing to check the thing, over the same
   # channel, so it has no independent anchor. Only the pkg does.
   set -e
   d=$(/usr/bin/mktemp -d) || exit 1
   trap "/bin/rm -rf \"$d\"" EXIT
   /usr/bin/curl -fsSL -o "$d/setup" "$0" || { echo "Kosmos: could not download the installer." >&2; exit 1; }
   # AN UNREACHABLE CHECKSUM REFUSES TOO, AND THAT IS DELIBERATE. The threat this
   # guards is a MISCONFIGURED origin, not a malicious one: an origin that can
   # serve you bad bytes can serve you a matching checksum, so the guard buys
   # nothing against that. What it does buy is protection against a HALF-PUBLISHED
   # site -- and a missing .sha256 is a symptom of exactly that state, not an
   # unrelated blip. Proceeding without the anchor would make this path no better
   # than the terminal one, which is the whole argument for the card.
   if ! /usr/bin/curl -fsSL -o "$d/sum" "$0.sha256"; then
     echo "Kosmos: could not check the installer against its published checksum, so it was not run." >&2
     echo "Nothing was installed. This usually means the download site is mid-update; it is safe to try again shortly." >&2
     exit 1
   fi
   want=$(/usr/bin/awk "{print \$1; exit}" "$d/sum")
   got=$(/usr/bin/shasum -a 256 "$d/setup" | /usr/bin/awk "{print \$1}")
   if [ -z "$want" ] || [ "$want" != "$got" ]; then
     echo "Kosmos: the installer did not match its published checksum, so it was NOT run." >&2
     echo "Nothing was installed. Please report this rather than retrying: a mismatch does not fix itself." >&2
     exit 1
   fi
   exec /bin/sh "$d/setup"' "$SETUP_URL" "$PAGE_OPENED"
rc=$?

if [ "$rc" -ne 0 ]; then
  echo "Kosmos: the install did not complete (exit $rc)." >&2
  exit "$rc"
fi
exit 0
