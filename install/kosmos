# #4884: an agent votes a post or a comment up or down (or takes its vote back), or reads where it stands against the
# daily ask (`votes`), through its own board. The VOTER is whoever the agent token says; the words here name only what
# is voted on. Like a follow, it carries the board token too.
cmd_community_vote() {
  local verb="$1"; shift
  local _usage="Usage: kosmos community vote <post|comment> <id> <up|down|clear>   (the id is the one shown after post or comment when you read)"
  if [ "$verb" = "votes" ]; then
    if [ $# -gt 0 ]; then say "Usage: kosmos community votes   (where you stand against the daily ask)"; exit 2; fi
  elif [ $# -ne 3 ]; then
    say "$_usage"
    exit 2
  fi
  if ! healthy; then
    say_not_up "nothing was voted"
    exit 1
  fi
  local _node; _node="$(kosmos_engine_node)" || { say "Kosmos cannot find its own runtime, so nothing was voted."; exit 1; }
  local _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in
    ''|*[!0-9a-f]*) ;;
    *) _tok="$KOSMOS_AGENT_TOKEN" ;;
  esac
  local _bt; _bt="$(board_token || true)"
  local _body _rc=0 _code
  if [ "$verb" = "votes" ]; then
    _body=$(kosmos_curl "$_bt" "$_tok" -sS -m 30 -w $'\n%{http_code}' "$URL/api/community/votes" 2>/dev/null) || _rc=$?
  else
    local payload
    payload=$(KC_KIND="$1" KC_ID="$2" KC_DIR="$3" KC_PANE="${TMUX_PANE:-}" "$_node" -e '
      const o = { kind: String(process.env.KC_KIND), id: String(process.env.KC_ID), direction: String(process.env.KC_DIR) };
      if (process.env.KC_PANE) o.from_pane = process.env.KC_PANE;
      process.stdout.write(JSON.stringify(o));
    ') || { say "We could not prepare that request, so nothing was voted."; exit 1; }
    _body=$(printf '%s' "$payload" | kosmos_curl "$_bt" "$_tok" -sS -m 30 -w $'\n%{http_code}' -X POST "$URL/api/community/vote" \
      -H 'content-type: application/json' --data-binary @- 2>/dev/null) || _rc=$?
  fi
  if [ "$_rc" -ne 0 ]; then
    if [ "$verb" = "votes" ]; then say_unreached "read your votes" "$_rc"; exit 1; fi
    case "$_rc" in
      18|28|52|56)   # a timeout or a cut answer: the board may have voted (exit 3, as Windows does for any answer after connecting)
        say "Kosmos did not finish answering. It may have happened; running it again is safe (the same vote twice changes nothing)."
        exit 3 ;;
    esac
    say_unreached "vote" "$_rc"
    exit 1
  fi
  _code="${_body##*$'\n'}"
  _body="${_body%$'\n'*}"
  local out _jrc=0
  out=$(printf '%s' "$_body" | "$_node" -e 'let s="";process.stdin.on("data",(d)=>s+=d).on("end",()=>{let j={};try{j=JSON.parse(s)||{}}catch{}const one=(v)=>String(v==null?"":v).replace(/[\t\r\n]+/g," ");if(j.ok===true&&typeof j.text==="string"){process.stdout.write(one(j.text)+(typeof j.nudge==="string"&&j.nudge?"\n"+one(j.nudge):""));process.exit(0)}process.stdout.write(one(j.error||"Kosmos gave an answer we could not read"));process.exit(3)})') || _jrc=$?   # exit 3 means "not ok"; set -e must not end the script here
  if [ "$_code" = "200" ] && [ "$_jrc" -eq 0 ]; then
    say "$out"
    exit 0
  fi
  if [ "$_code" = "202" ] && [ "$verb" = "vote" ]; then   # sent, not confirmed: it may have been counted
    say "Not confirmed: ${out:-Kosmos gave an answer we could not read}. It may have been counted; voting the same way again is safe."
    exit 3
  fi
  if [ "$verb" = "votes" ]; then say "Nothing was read: ${out:-Kosmos gave an answer we could not read}."; else say "Nothing was voted: ${out:-Kosmos gave an answer we could not read}."; fi
  exit 1
}

# #4913: an agent endorses another community agent (1 to 5 stars and a short review), or takes it back (`unendorse`),
# through its own board. The ENDORSER is whoever the agent token says; the words here name only who is endorsed. A
# name with spaces is one argument ("Theo Nguyen"). The review is the rest of the words, or stdin when there are none,
# as a comment's text is. Like a vote, it carries the board token too.
cmd_community_endorse() {
  local verb="$1"; shift
  local _usage="Usage: kosmos community endorse <agent-name> <1-5> <review>   (quote a name with spaces; or pipe the review in)"
  local name="" stars="" text=""
  if [ "$verb" = "unendorse" ]; then
    if [ $# -ne 1 ] || [ -z "$1" ]; then say "Usage: kosmos community unendorse <agent-name>   (quote a name with spaces)"; exit 2; fi
    name="$1"
  else
    if [ $# -lt 2 ] || [ -z "$1" ]; then say "$_usage"; exit 2; fi
    name="$1"; stars="$2"; shift 2
    case "$stars" in
      [1-5]) ;;
      *) say "Give 1 to 5 stars. $_usage"; exit 2 ;;
    esac
    if [ $# -gt 0 ]; then text="$*"; else text="$(cat)"; fi
    if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
      say "Nothing to send: an endorsement needs a short review (pass it after the stars, or pipe it in on stdin)."
      exit 2
    fi
  fi
  if ! healthy; then
    say_not_up "nothing was sent"
    exit 1
  fi
  local _node; _node="$(kosmos_engine_node)" || { say "Kosmos cannot find its own runtime, so nothing was sent."; exit 1; }
  local _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in
    ''|*[!0-9a-f]*) ;;
    *) _tok="$KOSMOS_AGENT_TOKEN" ;;
  esac
  local _bt; _bt="$(board_token || true)"
  local payload
  payload=$(KC_VERB="$verb" KC_NAME="$name" KC_STARS="$stars" KC_TEXT="$text" KC_PANE="${TMUX_PANE:-}" "$_node" -e '
    const o = process.env.KC_VERB === "unendorse"
      ? { name: String(process.env.KC_NAME), takeBack: true }
      : { name: String(process.env.KC_NAME), stars: Number(process.env.KC_STARS), text: String(process.env.KC_TEXT) };
    if (process.env.KC_PANE) o.from_pane = process.env.KC_PANE;
    process.stdout.write(JSON.stringify(o));
  ') || { say "We could not prepare that request, so nothing was sent."; exit 1; }
  local _body _rc=0 _code
  _body=$(printf '%s' "$payload" | kosmos_curl "$_bt" "$_tok" -sS -m 30 -w $'\n%{http_code}' -X POST "$URL/api/community/endorse" \
    -H 'content-type: application/json' --data-binary @- 2>/dev/null) || _rc=$?
  if [ "$_rc" -ne 0 ]; then
    case "$_rc" in
      18|28|52|56)   # a timeout or a cut answer: the board may have sent it (exit 3, as Windows does for any answer after connecting)
        say "Kosmos did not finish answering. It may have happened; running it again is safe (the same endorsement twice changes nothing)."
        exit 3 ;;
    esac
    if [ "$verb" = "unendorse" ]; then say_unreached "take back that endorsement" "$_rc"; else say_unreached "send that endorsement" "$_rc"; fi
    exit 1
  fi
  _code="${_body##*$'\n'}"
  _body="${_body%$'\n'*}"
  local out _jrc=0
  out=$(printf '%s' "$_body" | "$_node" -e 'let s="";process.stdin.on("data",(d)=>s+=d).on("end",()=>{let j={};try{j=JSON.parse(s)||{}}catch{}const one=(v)=>String(v==null?"":v).replace(/[\t\r\n]+/g," ");if(j.ok===true&&typeof j.text==="string"){process.stdout.write(one(j.text));process.exit(0)}process.stdout.write(one(j.error||"Kosmos gave an answer we could not read"));process.exit(3)})') || _jrc=$?   # exit 3 means "not ok"; set -e must not end the script here
  if [ "$_code" = "200" ] && [ "$_jrc" -eq 0 ]; then
    say "$out"
    exit 0
  fi
  if [ "$_code" = "202" ]; then   # sent, not confirmed: it may have happened
    say "Not confirmed: ${out:-Kosmos gave an answer we could not read}. It may have happened; running it again is safe."
    exit 3
  fi
  say "Nothing was sent: ${out:-Kosmos gave an answer we could not read}."
  exit 1
}

cmd_restart() {
  # The point is that start then runs the code that is on disk NOW, which
  # is what an update needs. The `|| true` tolerates "was not running";
  # it can NOT tolerate the stranger-on-the-port case, because that branch
  # of stop exits the process outright -- and that is correct here too:
  # a port owned by something we refuse to kill is a port start cannot
  # bind, so continuing would only move the failure one line down.
  _KOSMOS_RESTARTING=1
  cmd_stop || true
  # #4466: a busy board of ours that the stop could not reach (nothing tracked it) is reclaimed by this start.
  if [ "${_KOSMOS_RESTART_RECLAIM:-}" = 1 ]; then KOSMOS_RECLAIM_BUSY=1 cmd_start; else cmd_start; fi
}

# #2255: an agent reacts to a room post with an emoji (Discord-style). The
# operator reacts on the board; this is the agent's own surface, mirroring
# cmd_post -- the sender is this agent's token, else from_pane (never trusted from
# the body), so an agent can only ever react AS itself. The post id comes from `kosmos room`,
# which prints it in brackets before each post (e.g. [m3]). The route TOGGLES:
# reacting again with the same emoji takes the reaction back.
cmd_react() {
  local project post emoji body because
  project="${1:-}"; post="${2:-}"; emoji="${3:-}"
  if [ -z "$project" ] || [ -z "$post" ] || [ -z "$emoji" ]; then
    say "Usage: kosmos react <project-id> <post-id> <emoji>   (the post id is in brackets before each post in kosmos room, e.g. [m3])"
    exit 2
  fi
  _no_more_words react 3 "Usage: kosmos react <project-id> <post-id> <emoji>   (the post id is in brackets before each post in kosmos room, e.g. [m3])" "$@"   # kosmos#4889 review 6
  if ! healthy; then
    say_not_up "the reaction could not be kept"
    exit 1
  fi
  # Same hand-rolled JSON escaping as cmd_post, same bash-3.2 reason.
  local esc_project esc_post esc_emoji esc_pane
  esc_project=$(printf '%s' "$project" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_post=$(printf '%s' "$post" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_emoji=$(printf '%s' "$emoji" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_pane=$(printf '%s' "${TMUX_PANE:-}" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  local _bt; _bt="$(agent_board_token || true)"   # #1946: board token for an enforcing board; inert (omitted) when empty
  # rc is captured via `|| rc=$?`, NOT a bare `body=$(...); rc=$?`. The shebang is
  # /bin/bash (3.2 on macOS) under `set -euo pipefail`, where a failing command
  # substitution in a bare assignment ABORTS the whole process at that line -- so
  # the bare form would kill `kosmos` silently on a curl failure and never reach
  # the messages below (measured: a destroyed socket gave exit 52 and no output).
  # The `|| rc=$?` puts the assignment in an `||` list, which suppresses `set -e`.
  local rc=0
  # #4491: this agent's own token, in its plain-hex shape only (junk is dropped, as reply and report do),
  # so the board can tell the agent from the person. Off argv through kosmos_curl's mode-600 header file.
  local _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in ''|*[!0-9a-f]*) ;; *) _tok="$KOSMOS_AGENT_TOKEN" ;; esac
  body=$(kosmos_curl "$_bt" "$_tok" -sS -m 15 -X POST "$URL/api/react" \
    -H 'content-type: application/json' \
    --data "{\"project\":\"$esc_project\",\"of\":\"$esc_post\",\"emoji\":\"$esc_emoji\",\"from_pane\":\"$esc_pane\"}" 2>/dev/null) || rc=$?
  # A react TOGGLES, so a response lost AFTER the server acted (a -m 15 timeout on
  # a busy board -- curl exit 28) leaves the reaction APPLIED while a bare failure
  # message would invite a retry, and the retry would toggle it back OFF, ending
  # in the wrong state. Distinguish the timeout from unreachable and say the
  # reaction may have landed -- the same care cmd_post takes with its delivery.
  if [ "$rc" -eq 28 ]; then
    say "Kosmos was slow to answer and we stopped waiting. Your reaction may have landed; check the room before reacting again, because reacting again takes it back off."
    exit 3
  elif [ "$rc" -ne 0 ]; then
    say_unreached "keep that reaction" "$rc" write   # #4466: a cut reply (52/56) is busy too, not "is it running?"
    exit 1
  fi
  # #1704 PR2: the board is serving another Kosmos. A reaction is not kept: it
  # toggles room state this agent cannot see from here. The sentence equals
  # engine/outbox.js WRONG_WORLD_SENTENCES.notOpen (cli.world-outbox-1704.test.js
  # pins the two).
  case "$body" in '{"wrongWorld":true'*) say "Your Kosmos is not the one open right now, so that could not be done. Try again once it is open."; exit 1 ;; esac
  # The route answers 200 even for a refusal (a room-state answer read off `ok`),
  # and 400 {"error":...} only for an unreadable request. The verdict globs are
  # anchored on the leading keys -- success is `{"ok":true,"op":add|remove...}`
  # and a refusal is `{"ok":false,...}`, in that key order (the add/remove tests
  # pin it against real bodies). This is a clean key-order split for readability,
  # not a defence against a `because` injection: sendJson JSON-encodes the body,
  # so a `because` string's own quotes are escaped (`\"ok\":true`) and could not
  # have matched the success arm even unanchored. Same form cmd_post uses.
  case "$body" in
    '{"error":'*)
      because=$(printf '%s' "$body" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')
      say "Kosmos could not read that reaction: ${because:-it did not say why}."
      exit 1 ;;
  esac
  case "$body" in
    '{"ok":true,"op":"add"'*)     say "Reacted $emoji to that post." ;;
    '{"ok":true,"op":"remove"'*)  say "Took your $emoji back off that post." ;;
    '{"ok":false'*)
      because=$(printf '%s' "$body" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p')
      say "Not reacted: ${because:-we could not tell why}."
      exit 1 ;;
    *)
      say "Not reacted: Kosmos gave an answer we could not read."
      exit 1 ;;
  esac
}

# Read a project room's recent talk (#314): the tail, oldest first, shaped by
# the server (?as=text) because stock bash has no JSON parser. This is the
# command an agent brought in after a valve is taught, so it must work with
# nothing but curl.
cmd_room() {
  local project
  project="${1:-}"
  # #2710: `kosmos room reopen <project-id>` clears a room the loop-guard is
  # holding, so the next post lands, without having to type a content post to
  # do it. A subverb rather than a flag matches `feedback`'s shape. Edge, on
  # record: a project whose id is literally "reopen" cannot be READ with
  # `kosmos room reopen` (it is taken as the subverb); read it from the board.
  if [ "$project" = "reopen" ]; then
    local rproj because
    rproj="${2:-}"
    if [ -z "$rproj" ]; then
      say "Usage: kosmos room reopen <project-id>   (clears a room the loop-guard is holding, so the next post lands)"
      exit 2
    fi
    _no_more_words "room reopen" 1 "Usage: kosmos room reopen <project-id>   (clears a room the loop-guard is holding, so the next post lands)" "${@:2}"   # kosmos#4889 review 6
    if ! healthy; then
      say_not_up "the room cannot be reopened"
      exit 1
    fi
    local esc_rproj _rbody _rrc=0 _rcode _rbt
    require_valid_project_id "$rproj"
    esc_rproj="$rproj"
    _rbt="$(board_token || true)"   # #1946: board token for an enforcing board; the reopen route is board-token gated
    # Same rc/http-code capture as the room read below: never a bare
    # `local _rbody=$(...)` (local's own exit status would mask the curl
    # failure and the `|| _rrc=$?` would not fire).
    _rbody=$(kosmos_curl "$_rbt" "" -sS -m 15 -w $'\n%{http_code}' -X POST "$URL/api/project/$esc_rproj/room/reopen" 2>/dev/null) || _rrc=$?
    if [ "$_rrc" -ne 0 ]; then
      say_unreached "reopen that room" "$_rrc" write
      exit 1
    fi
    _rcode="${_rbody##*$'\n'}"
    _rbody="${_rbody%$'\n'*}"
    case "$_rcode" in
      2??) say "Reopened $rproj. The loop-guard hold is cleared; the next post to that room will land." ;;
      404) say "There is no project called \"$rproj\", so there is no room to reopen."; exit 1 ;;
      *)
        because=$(printf '%s' "$_rbody" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p')
        say "We could not reopen that room${because:+: $because}"
        exit 1 ;;
    esac
    exit 0
  fi
  # #4891 N8: `-n N` / `--limit N` (or `--limit=N`) reads only the last N rows (1 to 200; 40 without it). Before
  # this, -n was ignored and the whole tail printed. Either side of the project id.
  local _n="" _ngiven=0 _arg
  project=""
  while [ $# -gt 0 ]; do
    _arg="$1"; shift
    case "$_arg" in
      -n|--limit) _ngiven=1; _n="${1:-}"; shift 2>/dev/null || true ;;
      --limit=*)  _ngiven=1; _n="${_arg#--limit=}" ;;
      # Any other word is the project, even one starting with "-": Kosmos makes ids like "-drafts" from a name
      # like "- drafts" (store.safeKey keeps a leading hyphen), and those rooms were readable before (review 2).
      *)  if [ -z "$project" ]; then project="$_arg"; else say "kosmos room reads one project at a time."; exit 2; fi ;;
    esac
  done
  if [ -z "$project" ]; then
    say "Usage: kosmos room <project-id> [-n N]   (read a room, the last 40 rows or the last N, up to 200; or: kosmos room reopen <project-id> to clear a loop-guard hold)"
    exit 2
  fi
  # Checked as text first (no leading 0, at most 3 digits), so a huge number can never reach bash arithmetic.
  if [ "$_ngiven" = 1 ]; then
    case "$_n" in
      ''|*[!0-9]*|0*) say "-n takes a whole number from 1 to 200."; exit 2 ;;
    esac
    if [ "${#_n}" -gt 3 ] || [ "$_n" -gt 200 ]; then say "-n takes a whole number from 1 to 200."; exit 2; fi
  fi
  if ! healthy; then
    say_not_up "the room cannot be read"
    exit 1
  fi
  local esc_project
  require_valid_project_id "$project"
  esc_project="$project"
  local _bt; _bt="$(agent_board_token || true)"   # #1946: board token for an enforcing board; inert (omitted) when empty
  # #2702: capture the HTTP status so an UNKNOWN project (404, "there is no
  # project by that name") prints its sentence AND exits non-zero -- parity with
  # cmd_post/cmd_react, which reject a bad id with exit 1. Before this, curl
  # without -f returned 0 on a 404, so `room` alone reported a typo as an empty
  # room. curl still prints the 404 body, so the sentence reaches the reader; a
  # transport failure (curl rc != 0) stays the "could not reach" arm below.
  # bash-3.2 under set -euo pipefail: capture rc via `|| _rc=$?`, never a bare
  # `_body=$(...)` (a failing substitution aborts the process at that line), the
  # same care cmd_post takes.
  local _body _rc=0 _code
  # #4491 slice 4: the agent's own token too (plain hex only, as msg and post take it), so this read still works
  # once the CLI stops holding the person's board token.
  local _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in ''|*[!0-9a-f]*) ;; *) _tok="$KOSMOS_AGENT_TOKEN" ;; esac
  _body=$(kosmos_curl "$_bt" "$_tok" -sS -m 15 -w $'\n%{http_code}' "$URL/api/project/$esc_project/room?as=text${_n:+&n=$_n}" 2>/dev/null) || _rc=$?
  if [ "$_rc" -ne 0 ]; then
    say_unreached "read that room" "$_rc"
    exit 1
  fi
  # -w appended "\n<http_code>" as the final line: split it off the body tail.
  _code="${_body##*$'\n'}"
  _body="${_body%$'\n'*}"
  # printf '%s' (no added newline): the server body already carries its own
  # trailing newline, which survived the split above -- a '%s\n' would double it
  # and leave a spurious blank line after every `kosmos room`.
  printf '%s' "$_body"
  case "$_code" in
    4??|5??) exit 1 ;;
  esac
}

# ⭐ ONE-TIME ADOPTION (#570). Josh ruled it 2026-08-27: mint once for agents
# Kosmos can already vouch for, then strict from then on.
#
# 🛑 DRY RUN BY DEFAULT. `--confirm` is the whole safety design: a one-time
# widening of trust that can happen by mistyping is not one-time. Nothing else
# may call this -- not a hook, not startup, not a sync. A sync minting ids for
# all seventeen agents as a side effect is not hypothetical; it happened on
# 2026-08-26 at 23:17.
cmd_adopt() {
  local confirm=0
  case "${1:-}" in
    --confirm) confirm=1 ;;
    "") ;;
    *) say "kosmos adopt [--confirm]"; exit 2 ;;
  esac
  if [ ! -f "$NODE" ] || [ ! -x "$NODE" ] || [ ! -d "$KOSMOS_HOME/app" ]; then
    say "Kosmos cannot find its own runtime, so it cannot vouch for anything."
    exit 2
  fi
  KOSMOS_ADOPT_CONFIRM="$confirm" KOSMOS_ADOPT_BY="${USER:-unknown}" \
  "$NODE" -e '
    const base = process.argv[1];
    const status = require(base + "/engine/status");
    const adopt  = require(base + "/engine/adopt");
    let rows;
    try { rows = status.paneRoster(); }
    catch (e) {
      /* paneRoster THROWS when tmux could not be asked, rather than answering
         "no agents". Adoption must refuse there: vouching for a machine we
         cannot see is the one thing this must never do. */
      console.log("could not read the agents on this computer, so nothing was vouched for.");
      process.exit(2);
    }
    // #3237: adopt only sees agents RUNNING right now (paneRoster reads live tmux panes), so
    // file-based personas the user created but has not started yet are invisible here. Point them at
    // the dashboard Import flow, which disk-scans ~/.claude/agents for those files. Shown on the
    // review paths (before anything is written), not after a successful --confirm.
    const importHint = () => {
      console.log("");
      console.log("Note: kosmos adopt only adopts agents running right now. If you created agents");
      console.log("that are not running yet, open Kosmos and use \"Import an agent you already");
      console.log("have\" to load them from disk.");
    };
    const p = adopt.plan(rows);
    if (!p.eligible.length) {
      console.log("nothing to adopt: " + p.skipped.length + " agent(s) already have provenance or are not ours.");
      for (const s of p.skipped) console.log("  skip " + s.name + " -- " + s.because);
      importHint();
      process.exit(0);
    }
    console.log(p.eligible.length + " agent(s) would be adopted:");
    for (const e of p.eligible) console.log("  " + e.name);
    for (const s of p.skipped) console.log("  skip " + s.name + " -- " + s.because);
    if (process.env.KOSMOS_ADOPT_CONFIRM !== "1") {
      console.log("");
      console.log("Nothing was written. Run: kosmos adopt --confirm");
      importHint();
      process.exit(0);
    }
    const done = adopt.apply(rows, process.env.KOSMOS_ADOPT_BY);
    for (const d of done) console.log((d.ok ? "  adopted " : "  FAILED  ") + d.name + (d.ok ? " (" + d.instance + ")" : " -- " + d.because));
    const bad = done.filter((d) => !d.ok).length;
    process.exit(bad ? 1 : 0);
  ' "$KOSMOS_HOME/app"
}

