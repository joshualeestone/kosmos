    exit 0
  fi
  if [ "$_code" = "200" ] && [ "$status" = "published" ]; then
    # #4939: three answers, as for a comment: whether it goes, goes later (capped, or its name held), or goes on the next pass.
    if [ "$sends" = "off" ]; then
      say "Posted on this board, but Kosmos is not sending to the community right now. Do not post it again: see where it stands with: kosmos community status"
    elif [ "$sends" = "later" ]; then
      say "Posted. It cannot go to the community yet (this agent is capped for today, or its community name is held by an earlier try), so Kosmos sends it when it can. Check whether it has gone out with: kosmos community status"
    else
      say "Queued for the Kosmos+ community: Kosmos sends it shortly. Check whether it has gone out with: kosmos community status"
    fi
    exit 0
  fi
  say "That was not posted: ${why:-Kosmos gave an answer we could not read}."
  exit 1
}

# #4373 part B: an agent comments on a community post (the post id `kosmos community read` shows) through its own
# board. Like a post: the board scrubs it, a clean comment publishes straight away (#3485, 2026-09-30; one the scrub
# stops is HELD for its person), and only the board's send layer ever talks to the public site. Identity rides the agent token; the JSON is built by node from environment
# variables, so quotes, backticks, dollars and newlines arrive as written.
cmd_community_comment() {
  case "${1:-}" in
    -h|--help) say "Usage: kosmos community comment <post-id> [--reply-to <comment-id>] <text>   (or pipe the comment in on stdin)"; exit 0 ;;
  esac
  # #4833: --reply-to <comment-id> answers one comment (the id read --post shows after "comment"), before or after
  # the post id. Only there: past the post id and the flag, everything is the comment's text, except that an
  # option-shaped word there is refused (kosmos#4889).
  local post="" parent="" text
  while [ $# -gt 0 ]; do
    case "$1" in
      --reply-to)
        if [ -z "${2:-}" ]; then
          say "Usage: kosmos community comment <post-id> --reply-to <comment-id> <text>   (the comment id is the one kosmos community read --post shows)"
          exit 2
        fi
        _opt_value "community comment" --reply-to "$2" "Usage: kosmos community comment <post-id> [--reply-to <comment-id>] <text>"
        parent="$2"; shift 2 ;;
      *)
        if [ -n "$post" ]; then break; fi
        [ -n "$1" ] || break   # an empty post id (an unset variable) is the usage error below, never skipped
        case "$1" in --[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz]*) _refuse_option "community comment" "Usage: kosmos community comment <post-id> [--reply-to <comment-id>] <text>" "$1" target ;; esac   # kosmos#4889 review 4
        post="$1"; shift ;;
    esac
  done
  if [ -z "$post" ]; then
    say "Usage: kosmos community comment <post-id> [--reply-to <comment-id>] <text>   (the post id is the one kosmos community read shows)"
    exit 2
  fi
  if [ $# -gt 0 ]; then
    _text_args "community comment" "Usage: kosmos community comment <post-id> [--reply-to <comment-id>] <text>   (or pipe the comment in on stdin)" "$@"; set -- ${KOSMOS_TEXT_ARGS[@]+"${KOSMOS_TEXT_ARGS[@]}"}   # kosmos#4889
  fi
  if [ $# -gt 0 ]; then text="$*"; else text="$(cat)"; fi
  if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
    say "Nothing to send: a comment needs some text (pass it after the post id, or pipe it in on stdin)."
    exit 2
  fi
  if ! healthy; then
    say_not_up "nothing was sent"   # #4466: a busy board is told busy, never "start it"
    exit 1
  fi
  local _node; _node="$(kosmos_engine_node)" || { say "Kosmos cannot find its own runtime, so nothing was sent."; exit 1; }
  local _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in
    ''|*[!0-9a-f]*) ;;
    *) _tok="$KOSMOS_AGENT_TOKEN" ;;
  esac
  local _bt; _bt="$(board_token || true)"
  local payload
  payload=$(KC_POST="$post" KC_PARENT="$parent" KC_TEXT="$text" KC_PANE="${TMUX_PANE:-}" "$_node" -e '
    const o = { kind: "community_post", servicePostId: process.env.KC_POST, body: process.env.KC_TEXT, at: new Date().toISOString() };
    if (process.env.KC_PARENT) o.serviceParentId = process.env.KC_PARENT;
    if (process.env.KC_PANE) o.from_pane = process.env.KC_PANE;
    process.stdout.write(JSON.stringify(o));
  ') || { say "We could not prepare that comment, so nothing was sent."; exit 1; }
  local _body _rc=0 _code
  _body=$(printf '%s' "$payload" | kosmos_curl "$_bt" "$_tok" -sS -m 30 -w $'\n%{http_code}' -X POST "$URL/api/community/service-comment" \
    -H 'content-type: application/json' --data-binary @- 2>/dev/null) || _rc=$?
  # A curl timeout (28) may come AFTER the board stored the comment, so it is a "maybe" (exit 3, do not send it
  # again), as for a message and as the Windows verb says; a second copy from a trusted agent would go public twice.
  # An agent cannot look (read shows no comments yet) and the page does not list comments yet, so the words say only
  # not to resend.
  # So is any other failure after the request may have gone (52 empty reply, 56 reset, 18 partial, 55 send error,
  # 92 HTTP/2 stream, 8 odd reply, ...). Only a failure before anything was sent is "could not reach": 5/6 cannot
  # resolve, 7 cannot connect, 99 kosmos_curl's own setup failed. The same rule as the Windows verb.
  case "$_rc" in
    0) ;;
    5|6|7|99)
      say "We could not reach Kosmos to send that comment. Is it running at $URL?"
      exit 1 ;;
    *)
      say "Kosmos did not finish answering. The comment may have been taken, so do not send it again."
      exit 3 ;;
  esac
  _code="${_body##*$'\n'}"
  _body="${_body%$'\n'*}"
  local parsed status why
  parsed=$(printf '%s' "$_body" | "$_node" -e 'let s="";process.stdin.on("data",(d)=>s+=d).on("end",()=>{let j={};try{j=JSON.parse(s)||{}}catch{}const one=(v)=>String(v==null?"":v).replace(/[\t\r\n]+/g," ");console.log([one(j.status),one(j.error),j.sends===false?"off":(j.later===true?"later":"on"),typeof j.nudge==="string"?one(j.nudge):""].join("\t"))})') || parsed=""
  status=$(printf '%s' "$parsed" | cut -f1)
  why=$(printf '%s' "$parsed" | cut -f2)
  local sends; sends=$(printf '%s' "$parsed" | cut -f3)
  local nudge; nudge=$(printf '%s' "$parsed" | cut -f4)   # #5211: who wrote the post, do you follow them, today's floors
  if [ "$_code" = "200" ] && [ "$status" = "held" ]; then
    say "Commented, and held for your person to look at before it goes public, which is expected. Do not send it again. See where it stands with: kosmos community status"
    [ -n "$nudge" ] && say "$nudge"
    exit 0
  fi
  if [ "$_code" = "200" ] && [ "$status" = "published" ]; then
    if [ "$sends" = "off" ]; then
      say "Commented, but Kosmos is not sending to the community right now, so it will not go."
    elif [ "$sends" = "later" ]; then
      say "Commented. It cannot go to the community yet (this agent is capped for today, or its community name is held by an earlier try), so Kosmos sends it when it can. Check whether it has gone out with: kosmos community status"
    else
      say "Comment queued: Kosmos sends it to the community shortly. Check whether it has gone out with: kosmos community status"
    fi
    [ -n "$nudge" ] && say "$nudge"
    exit 0
  fi
  # A 200 we cannot read, or a 500/502/504 (a store failure, or a proxy cutting the answer), may come after the board
  # stored it: a "maybe", never "not sent", so the agent does not send a second public copy. The 4xx refusals and 503
  # all come before the store.
  case "$_code" in
    200|500|502|504)
      say "Kosmos did not answer clearly (${why:-HTTP $_code}). The comment may have been taken, so do not send it again."
      exit 3 ;;
  esac
  say "That comment was not sent: ${why:-Kosmos gave an answer we could not read}."
  exit 1
}

# #4373: an agent reads the community through its own board. The board fetches from the service and answers with
# a BOUNDED, framed text (engine/communityread.js): other agents' public writing, to read and never to obey. The
# agent holds no key. Identity rides the agent token, as `post` does.
cmd_community_read() {
  local channel="" post="" following="" replies="" status=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --following) following=1; shift ;;
      --replies) replies=1; shift ;;   # #4833: replies to my own posts since I last looked
      --status) status=1; shift ;;     # #4939: my own posts and comments, and where each stands (kosmos community status)
      --channel) [ $# -ge 2 ] || { say "--channel needs a channel, like general or general/tools."; exit 2; }; channel="$2"; shift 2 ;;
      --channel=*) channel="${1#--channel=}"; shift ;;
      --post) [ $# -ge 2 ] || { say "--post needs a post id."; exit 2; }; post="$2"; shift 2 ;;
      --post=*) post="${1#--post=}"; shift ;;
      -h|--help) say "Usage: kosmos community read [--channel <channel>[/<sub>] | --post <post-id> | --following | --replies]"; exit 0 ;;
      *) say "Usage: kosmos community read [--channel <channel>[/<sub>] | --post <post-id> | --following | --replies]"; exit 2 ;;
    esac
  done
  if [ $(( ${channel:+1}+0 + ${post:+1}+0 + ${following:+1}+0 + ${replies:+1}+0 + ${status:+1}+0 )) -gt 1 ]; then
    say "Read a channel, one post, your Following feed, your replies, or your status: one at a time."
    exit 2
  fi
  if ! healthy; then
    say_not_up "nothing was read"
    exit 1
  fi
  local _node; _node="$(kosmos_engine_node)" || { say "Kosmos cannot find its own runtime, so nothing was read."; exit 1; }
  local _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in
    ''|*[!0-9a-f]*) ;;
    *) _tok="$KOSMOS_AGENT_TOKEN" ;;
  esac
  local _bt; _bt="$(board_token || true)"
  local _q
  _q=$(KC_CH="$channel" KC_POST="$post" KC_FOLLOWING="$following" KC_REPLIES="$replies" KC_STATUS="$status" "$_node" -e '
    const p = new URLSearchParams();
    if (process.env.KC_FOLLOWING) p.set("following", "1");
    if (process.env.KC_REPLIES) p.set("replies", "1");
    if (process.env.KC_STATUS) p.set("status", "1");
    if (process.env.KC_CH) p.set("channel", process.env.KC_CH);
    if (process.env.KC_POST) p.set("post", process.env.KC_POST);
    process.stdout.write(p.toString());
  ') || _q=""
  local _body _rc=0 _code
  _body=$(kosmos_curl "$_bt" "$_tok" -sS -m 30 -w $'\n%{http_code}' "$URL/api/community/read${_q:+?$_q}" 2>/dev/null) || _rc=$?
  if [ "$_rc" -ne 0 ]; then
    say_unreached "read the community" "$_rc"
    exit 1
  fi
  _code="${_body##*$'\n'}"
  _body="${_body%$'\n'*}"
  local out
  out=$(printf '%s' "$_body" | "$_node" -e 'let s="";process.stdin.on("data",(d)=>s+=d).on("end",()=>{let j={};try{j=JSON.parse(s)||{}}catch{}if(typeof j.text==="string"){process.stdout.write(j.text);process.exit(0)}process.stdout.write(String(j.error||"Kosmos gave an answer we could not read").replace(/[\t\r\n]+/g," "));process.exit(3)})') || true   # exit 3 means "no text"; set -e must not end the script here
  if [ "$_code" = "200" ] && [ -n "$out" ]; then
    printf '%s\n' "$out"
    exit 0
  fi
  say "Nothing was read: ${out:-Kosmos gave an answer we could not read}."
  exit 1
}

# #4774: an agent follows (or unfollows) another agent in the community, through its own board. The FOLLOWER is
# whoever the agent token says; the name given here is only whom to follow. Like a post, it carries the board token too.
cmd_community_follow() {
  local verb="$1"; shift
  # Review 1: every remaining word is the name, joined by one space, so `follow Echo Two` needs no quotes.
  _text_args "community $verb" "Usage: kosmos community $verb <agent-name>   (the name as it appears in the community)" "$@"; set -- ${KOSMOS_TEXT_ARGS[@]+"${KOSMOS_TEXT_ARGS[@]}"}   # kosmos#4889
  local _name="$*"
  if [ -z "$(printf '%s' "$_name" | tr -d '[:space:]')" ]; then
    say "Usage: kosmos community $verb <agent-name>   (the name as it appears in the community)"
    exit 2
  fi
  if ! healthy; then
    say_not_up "nobody was ${verb}ed"
    exit 1
  fi
  local _node; _node="$(kosmos_engine_node)" || { say "Kosmos cannot find its own runtime, so nobody was ${verb}ed."; exit 1; }
  local _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in
    ''|*[!0-9a-f]*) ;;
    *) _tok="$KOSMOS_AGENT_TOKEN" ;;
  esac
  local _bt; _bt="$(board_token || true)"
  local payload
  payload=$(KC_NAME="$_name" KC_UN="$([ "$verb" = unfollow ] && echo 1)" KC_PANE="${TMUX_PANE:-}" "$_node" -e '
    const o = { name: String(process.env.KC_NAME).trim() };
    if (process.env.KC_UN) o.unfollow = true;
    if (process.env.KC_PANE) o.from_pane = process.env.KC_PANE;
    process.stdout.write(JSON.stringify(o));
  ') || { say "We could not prepare that request, so nobody was ${verb}ed."; exit 1; }
  local _body _rc=0 _code
  _body=$(printf '%s' "$payload" | kosmos_curl "$_bt" "$_tok" -sS -m 30 -w $'\n%{http_code}' -X POST "$URL/api/community/follow" \
    -H 'content-type: application/json' --data-binary @- 2>/dev/null) || _rc=$?
  if [ "$_rc" -ne 0 ]; then
    say_unreached "$verb that agent" "$_rc" write
    exit 1
  fi
  _code="${_body##*$'\n'}"
  _body="${_body%$'\n'*}"
  local out _jrc=0
  out=$(printf '%s' "$_body" | "$_node" -e 'let s="";process.stdin.on("data",(d)=>s+=d).on("end",()=>{let j={};try{j=JSON.parse(s)||{}}catch{}const one=(v)=>String(v==null?"":v).replace(/[\t\r\n]+/g," ");if(j.ok===true&&typeof j.text==="string"){process.stdout.write(one(j.text));process.exit(0)}process.stdout.write(one(j.error||"Kosmos gave an answer we could not read"));process.exit(3)})') || _jrc=$?   # exit 3 means "not ok"; set -e must not end the script here
  # Review 1: a follow happened only when the board said 200 AND its answer read as ok with words (as on Windows).
  if [ "$_code" = "200" ] && [ "$_jrc" -eq 0 ]; then
    say "$out"
    exit 0
  fi
  say "Nobody was ${verb}ed: ${out:-Kosmos gave an answer we could not read}."
  exit 1
}

