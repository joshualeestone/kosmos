#!/bin/bash
# The `kosmos` command. This file ships INSIDE the bundle at
# $KOSMOS_HOME/bin/kosmos; the installer symlinks it into ~/.local/bin and the
# app icon execs it. It is the one entry point that knows where everything
# lives, so nothing else has to.
#
#   kosmos start     start the board if it is not already running
#   kosmos stop      stop it
#   kosmos status    say whether it is running, in a sentence
#   kosmos open      start if needed, then open the dashboard in the browser
#   kosmos version   print the app version
#
# ⚠️ WHO RUNS THIS, because it governs the voice: mostly nobody. The person
# installs with one pasted line and lives in the icon and the browser tab from
# then on. This command exists for the installer, the icon's launcher, and the
# rare person who likes terminals. It still speaks in sentences, not codes,
# because the rare person deserves the same respect.
#
# ⚠️ BASH 3.2 AND NOTHING ELSE. macOS ships bash 3.2 and a clean Mac has no
# python3 (invoking it can trigger the Xcode command-line-tools dialog, which
# is exactly the kind of surprise this install must never produce). Everything
# here is plain POSIX-ish bash plus curl, which every Mac has.

set -euo pipefail

# ---- where am I -------------------------------------------------------------
# ⚠️ RESOLVED THROUGH THE SYMLINK BY HAND. The installer links this file into
# ~/.local/bin, so `dirname $0` there answers ~/.local/bin and every relative
# path breaks. The floor is macOS 13.5, whose readlink has -f, but the loop
# costs nothing, handles any chain of links the same way everywhere, and
# keeps this file free of a version assumption that would silently become
# the load-bearing fact if the floor ever moved. Follow links (relative ones
# resolve against the link's own directory) until a real file, then take its
# parent's parent as home.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF" ;; esac
done
KOSMOS_HOME="${KOSMOS_HOME:-$(cd "$(dirname "$SELF")/.." && pwd)}"

NODE="$KOSMOS_HOME/runtime/bin/node"
APP="$KOSMOS_HOME/app/server.js"
# ⚠️ ONE OF FIVE COPIES OF THE PINNED 16180 LITERAL (was three before
# #910 added `install/pkg-scripts/postinstall` and native-app/main.swift):
# here, `server.js` (its own bare-`node server.js` dev fallback only --
# every real invocation is handed an already-resolved PORT, never falls
# back to its own literal), `install/setup.sh`, `install/pkg-scripts/
# postinstall`, and native-app/main.swift's `kosmosDefaultPort()`. Of
# those, FOUR actually COMPUTE the full derivation (this file, setup.sh,
# postinstall, and main.swift) and must move together for real; server.js
# only ever consumes a port someone else already resolved. The installer
# BAKES the install-time port into the app bundle (`export KOSMOS_PORT=...`),
# so the icon always agrees with itself -- but somebody typing `kosmos start`
# in a terminal gets this one, and a stale copy here would start the board
# on a different port from the one the icon opens.
# 📌 16180, moved off 4317 because that is the OpenTelemetry OTLP default and
# collided with exactly this product's audience. See setup.sh for why it is not
# in 49152-65535.
# 🔑 PER-ACCOUNT, NOT ONE SHARED DEFAULT FOR EVERY macOS USER (#910). Every
# account defaulting to the identical port is the entire root cause of "a new
# macOS account opens Kosmos and sees another account's agents": 127.0.0.1
# sockets are machine-wide, not per-user, so account B's `healthy()` check
# always found account A's already-running board on the one shared port and
# never started (or needed) a board of its own. The store and KOSMOS_HOME
# were already correctly per-account (both default under $HOME); the port
# was the one piece that was not.
# uid 501 is pinned to the LITERAL, UNCHANGED value: macOS reserves UIDs
# below 500 for system/service accounts, and the Setup Assistant's first
# created user account gets 501 on every personal or family Mac -- the
# overwhelming majority of real installs today, all of them already
# hardcoded to 16180. Pinning that case means the single most common
# install on this machine changes zero bytes of observable behavior.
# Every OTHER uid gets a deterministic, stable alternate: `+1` on the
# modulo (not `uid % 4000` alone) because `uid % 4000` can itself equal 0,
# which added to 16180 would reproduce the literal primary port for some
# OTHER account -- the two cases can never collide by construction, not
# just by low probability. Two DIFFERENT non-primary uids landing on the
# SAME derived port (uid % 3999 wraps, e.g. 1000 and 4999) is accepted,
# not guarded against: real personal/family Macs have a handful of
# accounts at most, and macOS allocates uids sequentially from 501, so a
# same-machine collision between two ordinary accounts is not a case this
# needs to defend against today (see the plan for the full reasoning).
# No runtime probing and no persisted "which port
# did I end up on" record: this is a pure function of `id -u`, so every
# command (start/stop/status) independently derives the identical answer,
# stable regardless of whether any OTHER account's board happens to be up
# or down at the moment of the call. A probe-based design ("check the
# well-known port, see whose it is, fall back if foreign") was considered
# and rejected for exactly that race: it makes account B's own port depend
# on the transient state of account A's board.
_kosmos_uid="$(/usr/bin/id -u)"
if [ "$_kosmos_uid" = 501 ]; then
  _kosmos_default_port=16180
else
  _kosmos_default_port=$((16180 + 1 + (_kosmos_uid % 3999)))
fi
PORT="${KOSMOS_PORT:-$_kosmos_default_port}"
URL="http://127.0.0.1:$PORT"
PIDFILE="$KOSMOS_HOME/board.pid"
LOG_DIR="$KOSMOS_HOME/logs"
BOARD_LOG="$LOG_DIR/board.log"

# ---- the environment the board needs ----------------------------------------
# ⚠️ THE BUNDLED tmux COMES FIRST ON PATH. The engine calls `tmux` by name;
# on a clean Mac the only tmux is ours, and on a machine that also has a
# Homebrew tmux the board must still read the same server the agents run in.
# Two tmux BINARIES are fine so long as they share a socket directory; two
# VERSIONS picked at random per process are not, so ours wins deterministically.
# The PATH as the person had it, BEFORE ours goes first: the tmux picker below
# resolves the system tmux against this, never against the PATH this line
# rearranges (#728: probing `command -v tmux` after this export can only ever
# find the bundle, so the picker could not fire on the one machine it was
# written for).
_KOSMOS_PATH_SYS="$PATH"
export PATH="$KOSMOS_HOME/tmux/bin:$PATH"
# ⚠️ TERMINFO IS PINNED HERE, NOT ONLY IN THE INSTALLER. The installer's export
# dies with the installer's process; this is the process tree the app and its
# tmux actually run in. Same reasoning as the bundle tooling: the bundled
# ncurses carries a compiled-in terminfo path from the build machine, macOS
# ships /usr/share/terminfo, and pinning converts the documented fallback
# assumption into a fact.
export TERMINFO_DIRS="${TERMINFO_DIRS:-/usr/share/terminfo}"
# 🛑 A UTF-8 LOCALE, AND WITHOUT IT THE BOARD CANNOT READ A SINGLE AGENT.
# Measured on Josh's Mac, 2026-08-22, and reproduced here: tmux SANITISES its
# own format output when the locale is not UTF-8, replacing the tab separators
# (and anything non-ASCII) with underscores.
#
#   with a UTF-8 locale   angel-discord<TAB>0.0<TAB>2.1.237<TAB>0<TAB><TAB>✳ …
#   with none             angel-discord_0.0_2.1.237_0___ …
#
# The engine splits those lines on tabs, so every line is rejected, zero panes
# parse, and the board correctly refuses with "we could not make sense of what
# came back" — a running fleet, invisible, on a screen that cannot say why.
#
# ⚠️ IT BELONGS HERE RATHER THAN ONLY IN A launchd PLIST, and that mistake is
# exactly what shipped: the board's login job sets LANG, and every OTHER way of
# starting the board does not. A Terminal gives you one; the app icon and
# anything else macOS launches give you almost nothing. This file is the one
# path all of them go through.
#
# ⚠️ Deferring to a locale that is already set: a person whose Mac runs in
# another language has a UTF-8 locale of their own, and overriding it would
# make this command the thing that decides what language their agents' titles
# are shown in. Only the EMPTY case is filled.
export LANG="${LANG:-en_US.UTF-8}"
# ⚠️ THE APP IS TOLD WHERE ITS tmux IS, EXPLICITLY. PATH only fixes the
# engine's bare `tmux` calls (reading the board); agent CREATION and the
# first-run machine check resolve their tmux as AGENT_WORKFORCE_TMUX_BIN
# falling back to /opt/homebrew/bin/tmux -- which exists on every dev
# machine and on NO clean Mac this installer targets. Without this export
# the very first thing a new user does after pasting the line (create an
# agent) refuses, and the generated launchd plists bake the Homebrew path.
# Unfindable by testing on a machine with Homebrew tmux; found by reading
# the resolution chain.
# 🛑 AND THE BUNDLED COPY IS THE FALLBACK, NOT THE RULE. Two tmux binaries of
# different versions share one socket and CANNOT read each other's server: the
# older one answers "server exited unexpectedly" and sees nothing at all.
# Measured on this machine, 2026-08-22 -- Homebrew's tmux 3.6a lists thirteen
# sessions and the tmux we ship (3.5a) refuses the same socket outright.
#
# ⚠️ WHAT THAT COSTS IS THE ENTIRE ADOPT AUDIENCE. Josh's sister installed
# Kosmos on a machine already running two agents in tmux, in our own shape, and
# Kosmos could not see either of them. Not the naming, not the mark: it was
# looking through a binary that could not reach the running server. Everyone who
# already has agents has a tmux, and anyone whose tmux is newer than ours is
# invisible to us -- which is exactly the person the "you already have agents
# here" screen was written for. It had never been seen outside this team, and
# this team all run the version we ship against.
#
# 🔑 SO THE CHOICE IS MADE BY ASKING, NOT BY PREFERENCE. A tmux on PATH that can
# actually LIST a running server is the one that can see this machine's agents,
# and it wins for that reason alone. If it cannot list one -- no tmux, no server,
# a permissions refusal, anything -- nothing has been established and the bundled
# copy stays, which is the clean-Mac case this export was added for.
#
# ⚠️ IT CAN ONLY EVER IMPROVE ON THE OLD BEHAVIOUR. The old value is what runs
# whenever the probe does not positively succeed, so a machine with no tmux, or
# with a tmux that agrees with ours, is unchanged. An explicit
# AGENT_WORKFORCE_TMUX_BIN still wins over both: the harness sets it.
# 🛑 #728: THIS PROBE ONCE COULD NOT FIRE. It asked `command -v tmux` AFTER the
# bundle had been put first on PATH, so the "system" tmux it probed WAS the
# bundle, every time; on a machine with a newer real tmux server the bundle's
# probe exits 1 ("server exited unexpectedly"), the fallback is the bundle, and
# the system binary that can see the server is never asked. Measured by
# walking on such a machine (Pete, 2026-08-24): bundled list-sessions 1,
# /opt/homebrew/bin/tmux list-sessions 0. A guard that structurally cannot
# go red. Now the candidates are the system tmux resolved against the PATH
# from BEFORE our export, then the two places a Mac keeps one, never the
# bundle itself; the first that can LIST the running server wins.
# Was AGENT_WORKFORCE_TMUX_BIN an explicit choice on entry (set, and not
# marked as a previous launcher's pick)? Read once, before the picker runs.
_KOSMOS_TMUX_EXPLICIT=""
if [ -n "${AGENT_WORKFORCE_TMUX_BIN:-}" ] && [ "${KOSMOS_TMUX_BIN_PICKED:-}" != "1" ]; then _KOSMOS_TMUX_EXPLICIT=1; fi
_kosmos_pick_tmux() {
  # Already chosen for us (harness, or a person who knows what they are doing)
  # ... unless the chooser was an EARLIER RUN OF THIS LAUNCHER. Its pick rides
  # the environment down the in-app update chain (old server -> update.js ->
  # setup.sh -> kosmos start), so the launcher the update just installed met
  # the old launcher's bundled pick, took it for a deliberate choice, and a Mac
  # with a newer tmux server stayed blind across every in-app update until a
  # clean-env restart (Pete, #728, measured on 0.5.24 -> 0.5.25). A pick this
  # launcher makes is exported WITH the marker below; a person's or a
  # harness's choice carries no marker and is honoured exactly as before.
  if [ -n "${AGENT_WORKFORCE_TMUX_BIN:-}" ] && [ "${KOSMOS_TMUX_BIN_PICKED:-}" != "1" ]; then
    return 0
  fi
  unset AGENT_WORKFORCE_TMUX_BIN
  _bundled="$KOSMOS_HOME/tmux/bin/tmux"
  _sys="$(PATH="${_KOSMOS_PATH_SYS:-$PATH}" command -v tmux 2>/dev/null || true)"
  # The two places a Mac keeps a tmux, for the board under launchd, whose PATH
  # is minimal. KOSMOS_TMUX_KNOWN is a harness seam ONLY: a test that pretends
  # to be a machine with no tmux must be able to hide this Mac's real one.
  for _cand in "$_sys" ${KOSMOS_TMUX_KNOWN-/opt/homebrew/bin/tmux /usr/local/bin/tmux}; do
    [ -n "$_cand" ] && [ -x "$_cand" ] || continue
    [ "$_cand" = "$_bundled" ] && continue
    # `list-sessions`, not `-V`: the question is whether it can reach the
    # server, and a version string proves only that a binary exists.
    if "$_cand" list-sessions >/dev/null 2>&1; then
      AGENT_WORKFORCE_TMUX_BIN="$_cand"
      return 0
    fi
  done
  AGENT_WORKFORCE_TMUX_BIN="$_bundled"
}
_kosmos_pick_tmux
export AGENT_WORKFORCE_TMUX_BIN
# The marker: "this value was picked by the launcher, not chosen by a person",
# so the next launcher in a chain re-picks instead of inheriting. Set only
# when the value is ours (an inherited explicit choice returned above with
# the marker unset, and stays unmarked).
if [ "${KOSMOS_TMUX_BIN_PICKED:-}" = "1" ] || [ -z "${_KOSMOS_TMUX_EXPLICIT:-}" ]; then
  KOSMOS_TMUX_BIN_PICKED=1; export KOSMOS_TMUX_BIN_PICKED
fi
# The engine's bare `tmux` calls must agree with the choice: when a system tmux
# won, its directory goes first, so two processes never read the same socket
# through two versions.
case "$AGENT_WORKFORCE_TMUX_BIN" in
  "$KOSMOS_HOME/tmux/bin/tmux") ;;
  *) export PATH="$(dirname "$AGENT_WORKFORCE_TMUX_BIN"):$PATH" ;;
esac

# The installer sets KOSMOS_SAY_INDENT so this command's narration nests as
# detail under the installer's own step lines instead of reading as new
# steps; run by hand, it stays at the command's two-space voice.
say() { printf '%s%s\n' "${KOSMOS_SAY_INDENT:-  }" "$*"; }
die() { printf '  %s\n' "$*" >&2; exit 1; }

# ⚠️ IDENTITY, NOT JUST A 200. Any process squatting on the port answers a
# bare liveness probe, and then start/status/the app icon would all point a
# person at a stranger's page and call it Kosmos. The board serves its own
# UI at /, so the probe asks for the page and checks it is ours.
# ⚠️ A case STATEMENT, NOT `printf | grep -q`: under pipefail, grep -q
# exits on its early match and printf takes SIGPIPE writing the rest of a
# 250KB page, so the pipeline reports failure on a page that MATCHED --
# which here would call our own running board a stranger. Measured in the
# bundle build's smoke test, which failed its own healthy bundle this way.
healthy() {
  local _body
  _body="$(/usr/bin/curl -fsS -m 2 "$URL/" 2>/dev/null)" || return 1
  case "$_body" in
    *"Agent Workforce"*|*Kosmos*) return 0 ;;
    *) return 1 ;;
  esac
}
# The port answers but not with our page: somebody else lives there.
port_taken_by_stranger() {
  /usr/bin/curl -s -o /dev/null -m 2 "$URL/" 2>/dev/null && ! healthy
}

running_pid() {
  # The pidfile is a hint, not the truth: verify the process exists AND is
  # ours before believing it. A stale pid that now belongs to a random
  # process must not make `stop` kill a stranger.
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null)" || return 1
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  # Pipe-free for the same pipefail/SIGPIPE reason healthy() documents;
  # ps output is one short line, but the pattern is banned, not the size.
  case "$(ps -p "$pid" -o command= 2>/dev/null)" in
    *"app/server.js"*) ;;
    *) return 1 ;;
  esac
  printf '%s' "$pid"
}

cmd_start() {
  if healthy; then
    say "Kosmos is already running at $URL"
    return 0
  fi
  if port_taken_by_stranger; then
    die "Another app on this computer is already using port $PORT, so Kosmos cannot start there. Quit that app and run 'kosmos start' again."
  fi
  # ⚠️ A recorded board that is alive but not answering on THIS port must
  # not be silently orphaned: overwriting the pidfile with a new launch
  # leaves the old process unreachable by stop forever (its only exit a
  # reboot), and the new one dies on the taken port anyway.
  local _oldpid
  if _oldpid="$(running_pid)"; then
    die "A Kosmos board from this install is already running (process $_oldpid) but is not answering on port $PORT. Stop it first with 'kosmos stop', then start again."
  fi
  [ -x "$NODE" ] || die "Kosmos looks incomplete: the runtime is missing. Reinstalling fixes this: curl -fsSL https://installkosmos.com/setup | sh"
  [ -f "$APP" ]  || die "Kosmos looks incomplete: the app is missing. Reinstalling fixes this: curl -fsSL https://installkosmos.com/setup | sh"
  [ -x "$KOSMOS_HOME/tmux/bin/tmux" ] || die "Kosmos looks incomplete: its terminal manager is missing. Reinstalling fixes this: curl -fsSL https://installkosmos.com/setup | sh"
  mkdir -p "$LOG_DIR"
  say "Bringing the board up."
  # Detached from this terminal, with everything it prints kept in a log so a
  # problem produces a transcript rather than a vanished window.
  # ⚠️ stdin FROM /dev/null AND FD 3 CLOSED. An earlier installer saved its
  # screen stream on fd 3; the server inherited it and a `curl | sh` install
  # NEVER RETURNED -- the shell's pipe could not reach EOF while the server
  # held the descriptor (measured). The installer no longer opens fd 3, but
  # any CALLER might: the server needs no terminal and no caller's plumbing,
  # so it gets neither, whoever launched it.
  PORT="$PORT" nohup "$NODE" "$APP" </dev/null >> "$BOARD_LOG" 2>&1 3>&- &
  printf '%s' "$!" > "$PIDFILE"
  # ⚠️ WAIT FOR THE BOARD TO ANSWER, NOT FOR THE PROCESS TO EXIST. A pid that
  # crashes half a second in still had a pid. Thirty half-second tries is
  # fifteen seconds, which covers a slow first boot with headroom; the log is
  # named on failure because it is the only witness.
  local i
  for i in $(seq 1 30); do
    healthy && { say "Kosmos is running at $URL"; return 0; }
    kill -0 "$(cat "$PIDFILE")" 2>/dev/null || break
    sleep 0.5
  done
  die "Kosmos did not come up. What it said is in $BOARD_LOG"
}

cmd_stop() {
  local pid
  if pid="$(running_pid)"; then
    # ⚠️ The pidfile is pid-scoped and the health check is port-scoped, and
    # they can disagree: with KOSMOS_PORT pointed elsewhere, status says
    # "not running" while the recorded process is alive on its original
    # port. Killing it silently made two adjacent commands contradict each
    # other, with the destructive one lying. Say which board this is.
    if ! healthy; then
      say "Stopping a Kosmos board that is not answering on port $PORT (it was likely started with a different port)."
    else
      say "Stopping Kosmos."
    fi
    kill "$pid" 2>/dev/null || true
    local i
    for i in $(seq 1 10); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.3
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    # ⚠️ ASKED IS NOT STOPPED. This said "Stopped." unconditionally and removed
    # the pidfile either way, so a kill that did not work made Kosmos FORGET a
    # live process -- into exactly the state this file describes below as
    # "something is answering that this command did not start". The pidfile is
    # the only handle we have on it, so a failed stop KEEPS it and says so.
    if kill -0 "$pid" 2>/dev/null; then
      say "Could not stop it. Something is still running as $pid."
      exit 1
    fi
    rm -f "$PIDFILE"
    say "Stopped."
  elif healthy; then
    # Answering on the port but not our recorded process: somebody started it
    # by hand, or the pidfile is gone. Say what is true instead of guessing.
    die "Something is answering at $URL but it was not started by this command, so it was left alone."
  else
    say "Kosmos is not running."
  fi
}

cmd_status() {
  if healthy; then
    local pid
    pid="$(running_pid)" || pid=""
    if [ -n "$pid" ]; then say "Kosmos is running at $URL"; else say "Kosmos is running at $URL (started outside this command)"; fi
  elif port_taken_by_stranger; then
    # The same answer start would give, so two adjacent commands cannot
    # hand out advice the next one refuses.
    say "Kosmos is not running, and another app is using port $PORT, so 'kosmos start' will refuse. Quit that app first."
    exit 1
  else
    say "Kosmos is not running. Start it with: kosmos start"
    exit 1
  fi
}

cmd_open() {
  healthy || cmd_start
  exec /usr/bin/open "$URL"
}

# The direct look the board names when it cannot read the agents (#274).
# Kosmos ships its own tmux off PATH, so `tmux ls` in a Terminal says
# "command not found" at the exact moment somebody wants it; this runs the
# tmux the board itself uses (resolved above), and says so.
cmd_agents() {
  if [ ! -x "$AGENT_WORKFORCE_TMUX_BIN" ]; then
    say "Kosmos cannot find its tmux at $AGENT_WORKFORCE_TMUX_BIN"
    exit 1
  fi
  say "Sessions on this computer, as Kosmos's own tmux sees them ($AGENT_WORKFORCE_TMUX_BIN):"
  # 🛑 "None" ONLY WHEN THERE IS NO SERVER (#728). A tmux that cannot READ the
  # server (an older binary on a newer server answers "server exited
  # unexpectedly") is not an empty machine, and a confident None ends the
  # search at exactly the moment a person is trying to find their agents.
  # tmux says "no server running on <socket>" or "error connecting to
  # <socket> (No such file or directory)" for a genuinely absent server; any
  # other refusal is blindness, and is said as blindness.
  _ls="$("$AGENT_WORKFORCE_TMUX_BIN" list-sessions 2>&1)"; _rc=$?
  if [ "$_rc" -eq 0 ]; then
    printf '%s\n' "$_ls"
    return 0
  fi
  case "$_ls" in
    *"no server running"*|*"No such file or directory"*)
      say "None. No tmux server is running for Kosmos's tmux, so no agent started by Kosmos is running."
      exit 1 ;;
    *)
      say "Could not see. Kosmos's tmux ($AGENT_WORKFORCE_TMUX_BIN) could not read the tmux server on this computer: $_ls"
      say "A tmux of a different version is holding that server, so agents may well be running that this binary cannot list."
      say "To look through the tmux that owns it:  AGENT_WORKFORCE_TMUX_BIN=/opt/homebrew/bin/tmux kosmos agents"
      exit 2 ;;
  esac
}

cmd_version() {
  if [ -x "$NODE" ] && [ -f "$KOSMOS_HOME/app/package.json" ]; then
    # The path travels as an environment variable, never interpolated into
    # the JS source: a quote or backslash in a path must stay a path.
    KOSMOS_PKG="$KOSMOS_HOME/app/package.json" "$NODE" -p 'JSON.parse(require("fs").readFileSync(process.env.KOSMOS_PKG,"utf8")).version'
  else
    die "Kosmos looks incomplete here."
  fi
}

# ---- kosmos msg <agent> <text…> ---------------------------------------------
# An agent messages a colleague. The SENDER IS NOT AN ARGUMENT: the server
# derives it from the tmux pane this command runs inside ($TMUX_PANE), so an
# agent cannot mistype itself into being someone else. Everything else about
# delivery (exact name, live pane, the loop valve, the message record) is the
# server's job; this command's job is to carry the words and REPORT THE
# VERDICT, because a send that fires and assumes success silently loses
# messages -- the transport lesson this port exists to keep.

cmd_msg() {
  local to text body verdict state because
  to="${1:-}"
  shift 2>/dev/null || true
  text="$*"
  if [ -z "$to" ] || [ -z "$text" ]; then
    say "Usage: kosmos msg <agent> <what you want to tell them>"
    exit 2
  fi
  if ! healthy; then
    say "Kosmos is not running, so nothing can be delivered. Start it with: kosmos start"
    exit 1
  fi
  # JSON-escaped by hand, because this must run on a clean Mac's bash 3.2
  # with no python3 (see the header). Newlines and tabs become spaces FIRST
  # (the server collapses them identically, so nothing is lost; left raw
  # they break the JSON in transit and never reach the server's refusal at
  # all); then backslash, then quotes.
  local esc_to esc_text esc_pane
  esc_to=$(printf '%s' "$to" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_text=$(printf '%s' "$text" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_pane=$(printf '%s' "${TMUX_PANE:-}" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  # No -f: an HTTP error still carries the server's own sentence, and
  # "could not reach" is a wrong diagnosis for a reachable server that
  # refused. Only a transport failure gets the unreachable sentence.
  body=$(curl -sS -m 15 -X POST "$URL/api/msg" \
    -H 'content-type: application/json' \
    --data "{\"to\":\"$esc_to\",\"text\":\"$esc_text\",\"from_pane\":\"$esc_pane\"}" 2>/dev/null) || {
    say "We could not reach Kosmos to send that. Is it running at $URL?"
    exit 1
  }
  case "$body" in
    *'"error"'*)
      because=$(printf '%s' "$body" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')
      say "Kosmos refused that request: ${because:-it did not say why}."
      exit 1
      ;;
  esac
  # The verdict, in the server's own words. Three states: placed is a
  # delivery, unconfirmed means the text may already be in their composer
  # (do NOT re-send), could_not names why.
  case "$body" in
    *'"state":"placed"'*)      say "Placed into $to's session." ;;
    *'"state":"unconfirmed"'*)
      # The server's own sentence: unconfirmed has two flavors (typed with
      # Enter unconfirmed, or a send that timed out mid-flight) and only
      # the server knows which. Exit 3, distinct from placed, so an
      # exit-code caller cannot read "maybe" as "delivered" -- but never
      # nonzero-1, which would invite the retry the state exists to stop.
      because=$(printf '%s' "$body" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p')
      say "Not confirmed: ${because:-the text may already be in their composer}. Do not re-send; check with them."
      exit 3
      ;;
    *)
      because=$(printf '%s' "$body" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p')
      say "Not delivered: ${because:-we could not tell why}."
      exit 1
      ;;
  esac
}

# ---- kosmos reply <text…> ---------------------------------------------------
# Answer the person, in the box on your own page.
#
# 🛑 THE COMMAND THAT DID NOT EXIST. `post` reaches a room and `msg` types into
# another agent's terminal; NEITHER reaches the person who messaged you. Until
# this, an agent answered in its own session, which reaches nobody, and the
# person watched an empty box (#175).
#
# ⚠️ NO RECIPIENT ARGUMENT, and that is the point rather than a shortcut: there
# is exactly one person to answer, and the sender is taken from TMUX_PANE so an
# agent can only ever write as itself.
cmd_reply() {
  local text body because
  text="$*"
  if [ -z "$text" ]; then
    say "Usage: kosmos reply <what you want to tell them>"
    exit 2
  fi
  if ! healthy; then
    say "Kosmos is not running, so this could not be kept. Start it with: kosmos start"
    exit 1
  fi
  local esc_text esc_pane
  esc_text=$(printf '%s' "$text" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_pane=$(printf '%s' "${TMUX_PANE:-}" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  body=$(curl -sS -m 15 -X POST "$URL/api/reply" \
    -H 'content-type: application/json' \
    --data "{\"text\":\"$esc_text\",\"from_pane\":\"$esc_pane\"}" 2>/dev/null) || {
    say "We could not reach Kosmos to keep that. Is it running at $URL?"
    exit 1
  }
  case "$body" in
    *'"error"'*)
      because=$(printf '%s' "$body" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')
      say "Kosmos refused that: ${because:-it did not say why}."
      exit 1 ;;
    *'"kept":true'*)
      # ⚠️ "It is on their screen" is what this can claim and the LIMIT of it:
      # the reply is in the record the page reads. Whether anybody is looking is
      # not ours to say, and a sentence implying they saw it would be the
      # overclaim this product keeps removing.
      # ⚠️ "IN THEIR CONVERSATION WITH YOU" IS WHAT THIS KNOWS. The earlier
      # wording said "on their screen now" — and the reply is in a FILE; the
      # page renders it only while that agent's panel is open. Whether anybody
      # is looking is not ours to say, which the comment above already said
      # while the sentence below asserted it anyway.
      say "Answered. It is in their conversation with you."
      ;;
    *)
      because=$(printf '%s' "$body" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p')
      say "That was not kept: ${because:-we could not tell why}."
      exit 1 ;;
  esac
}

cmd_post() {
  local project text body because
  project="${1:-}"
  shift 2>/dev/null || true
  text="$*"
  if [ -z "$project" ] || [ -z "$text" ]; then
    say "Usage: kosmos post <project-id> <what you want to tell the room>"
    exit 2
  fi
  if ! healthy; then
    say "Kosmos is not running, so nothing can be posted. Start it with: kosmos start"
    exit 1
  fi
  # Same hand-rolled JSON escaping as cmd_msg, same bash-3.2 reason.
  local esc_project esc_text esc_pane
  esc_project=$(printf '%s' "$project" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_text=$(printf '%s' "$text" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_pane=$(printf '%s' "${TMUX_PANE:-}" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  # -m 120, not msg's 15: delivery fans out SERIALLY and a wedged tmux
  # can stall ~15s per recipient, so a room-sized timeout has to cover
  # several. And the timeout arm is distinguished from unreachable (curl
  # exit 28 vs the rest): "could not reach" for a server mid-delivery is
  # the misdiagnosis cmd_msg's own comment warns about, and it invites
  # the re-post the unconfirmed state exists to stop.
  body=$(curl -sS -m 120 -X POST "$URL/api/post" \
    -H 'content-type: application/json' \
    --data "{\"project\":\"$esc_project\",\"text\":\"$esc_text\",\"from_pane\":\"$esc_pane\"}" 2>/dev/null)
  rc=$?
  if [ "$rc" -eq 28 ]; then
    say "Kosmos is still delivering that post and we stopped waiting. Do not re-post; the room screen shows who got it."
    exit 3
  elif [ "$rc" -ne 0 ]; then
    say "We could not reach Kosmos to post that. Is it running at $URL?"
    exit 1
  fi
  # ⚠️ Globs are ANCHORED on the top-level keys. The post response embeds
  # `outcomes`, an object keyed by AGENT NAMES -- an agent named "state"
  # or "error" would otherwise put the matching substring into the body
  # and flip the verdict (a partial post reading "everyone received it").
  case "$body" in
    '{"error":'*)
      because=$(printf '%s' "$body" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')
      say "Kosmos refused that request: ${because:-it did not say why}."
      exit 1
      ;;
  esac
  # Three states, the same contract as msg -- but a post's placed means
  # EVERY member got it; unconfirmed means the room is partly reached
  # (the outcomes live in the record for the screens to draw).
  case "$body" in
    '{"delivery":{"state":"placed"'*)      say "Posted to $project. Everyone on it has it waiting." ;;
    '{"delivery":{"state":"unconfirmed"'*)
      because=$(printf '%s' "$body" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p')
      say "Posted, but not everyone is confirmed${because:+: $because}. Do not re-post; the room screen shows who got it."
      exit 3
      ;;
    *)
      because=$(printf '%s' "$body" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p')
      say "Not posted: ${because:-we could not tell why}."
      exit 1
      ;;
  esac
}

# ---- kosmos whoami
# Which account and model THIS agent is running on.
#
# Josh, 2026-08-28: "I asked the models to tell me what account they were on.
# One of them could not tell me this. One of them could and then another one
# told me that they couldn't." Two of three could not answer, and the
# INCONSISTENCY was the worse half: a person who gets an answer from one agent
# reasonably concludes the others are broken.
#
# 🔑 NO ARGUMENT, and that is deliberate rather than minimal. The sender is
# derived from the pane or the launch token, exactly as `report` derives it, so
# an agent cannot ask who SOMEBODY ELSE is by naming them.
#
# 🔑 THE SENTENCE IS COMPOSED BY THE BOARD, not here and not by the agent. If
# every agent phrases this itself, three agents give three answers, which is
# the defect this verb exists to remove.
cmd_whoami() {
  if ! healthy; then
    say "Kosmos is not running, so it cannot tell you which account you are on. Start it with: kosmos start"
    exit 1
  fi
  local body esc_pane _tok
  esc_pane=$(printf '%s' "${TMUX_PANE:-}" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  # Same token rule as `report`: only a hex value is presented, because
  # /api/whoami reads `header || body.token` and a junk header would take the
  # token arm and fail there rather than falling through to the pane.
  _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in
    ''|*[!0-9a-f]*) ;;
    *) _tok="$KOSMOS_AGENT_TOKEN" ;;
  esac
  body=$(curl -sS -m 15 -X POST "$URL/api/whoami" \
    -H 'content-type: application/json' \
    ${_tok:+-H "x-kosmos-agent-token: $_tok"} \
    -d "{\"from_pane\":\"$esc_pane\"}" 2>&1) || {
      say "Kosmos did not answer, so we cannot tell you which account you are on."
      exit 1
    }
  # The sentence the board composed, verbatim. Falling back to the raw body
  # rather than to a sentence of our own: a locally-invented answer is exactly
  # what this verb exists to stop.
  case "$body" in
    *'"because"'*) printf '%s\n' "$body" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p' ;;
    *) printf '%s\n' "$body" ;;
  esac
}

# ---- kosmos connections
# What is connected on this computer (#1034 part 2). VERDICT ONLY, on purpose:
# the board's own /api/connect answer carries a live sign-in URL and raw
# terminal output, which is a bearer credential to hand an agent. This reads
# /api/agent/connections, which is constructed rather than filtered.
#
# 🛑 Three answers, never two. "could not check" is a real answer and is not
# collapsed into "not connected" -- the same rule cmd_agents states, for the
# same reason: a confident negative ends the search at the moment somebody is
# trying to get connected.
cmd_connections() {
  if ! healthy; then
    # ⚠️ "$SELF start", NOT bare "kosmos start". Every sibling verb says the bare
    # form and this deliberately does not match them, for one reason: THIS verb's
    # primary caller is an AGENT that was handed an absolute path, and the bare
    # form is what engine/connections.js:3 calls a measured lie on a stock
    # install (~/.local/bin is not on a default macOS PATH). A person in a
    # terminal usually has it working; an agent following instructions does not.
    # The siblings are reached by a person and are left alone on purpose:
    # changing them is a separate card, not a drive-by in a privacy change.
    # ⚠️ QUOTED in the printed line. An install path with a space yields advice a
    # person cannot paste, and clipath.js goes to real trouble to quote exactly
    # this class for the block while the CLI's own advice did not.
    say "Kosmos is not running, so it cannot tell you what is connected. Start it with: \"$SELF\" start"
    exit 1
  fi
  local body
  # ⏱ 40s, not 15. This route composes a LIVE per-account check for BOTH
  # providers (a `claude auth status` subprocess per Claude account, and an
  # authenticated request to api.openai.com per OpenAI account) plus THREE
  # first-party doors. The OpenAI half was missing from this sentence too, and it
  # is the one that depends on the network rather than on this machine, which is
  # most of the reason 15s was not enough.
  # 🛑 THREE requests leave the machine, not one. Cloudflare and
  # the github device fallback each make an uncached authenticated call too
  # (measured: `cache` appears zero times in either module). None is billed, so
  # the money decision is unchanged; the timeout budget is about all three. (It used to be the
  # whole door sweep; the metered token doors were dropped from this route as a
  # money decision, so the budget is smaller than it was when 40s was chosen.
  # Left at 40 deliberately: the cost that set it was the per-account subprocess
  # sweep, which has not changed.) The arms run in
  # parallel so the real cost is bounded near the slowest one, but 15s left no
  # margin on a machine with several accounts and a slow network door.
  # 🛑 `|| { ... }`, NOT `; rc=$?`. This script runs under `set -euo pipefail`
  # (line 24), and a failing command substitution in a plain assignment is a
  # simple command: the shell EXITS THERE. An earlier version of this block wrote
  # `body=$(curl ...); rc=$?`, which made BOTH sentences below unreachable --
  # measured, with both arms: under `set -e` it printed nothing and exited with
  # curl's raw code (7, 28, ...), and the same function with `set -e` removed
  # printed the sentence. The success path still reached `rc=0`, which is why it
  # looked fine. Every sibling verb (`cmd_msg`, `cmd_whoami`) uses this form.
  # ⚠️ And no `2>&1`: folding curl's stderr into $body swallowed its own message
  # as well, so a person got silence from both halves at once.
  # ⭐ `2>/dev/null` is NOT the same mistake. (It is what ONE sibling uses:
  # `cmd_msg` at :475. `cmd_whoami` at :662 uses `2>&1`, which is the form the
  # note above calls the mistake. "the sibling verbs use it" was true of one of
  # the two this block names three lines up.)
  # `2>&1` redirects INTO the variable, which is what ate the message. This
  # DISCARDS it, so the reader gets our sentence instead of `curl: (28) Operation
  # timed out` printed above it. Keeping both means the verb whose stated job is
  # refusing machine vocabulary prints machine vocabulary first. The exit status
  # is what we branch on, and a redirect does not touch it.
  local rc
  # The deadline is overridable ONLY so a test can drive the rc-28 arm below.
  # Two reviews found that arm was the one failure sentence here with no test,
  # and this file already shipped two sentences DEAD once, under a green suite.
  # Hard-coding the 40 is what made it undriveable; nothing else reads this var.
  #
  # 🛑 VALIDATED, BECAUSE `curl -m 0` MEANS NO TIMEOUT AT ALL. The var is read
  # from the ambient environment in production, so a stray or zero value would
  # silently remove the 40s ceiling and make the "took longer than we waited"
  # sentence below unreachable: the CLI would hang instead of saying so. A test
  # seam that can disable a production guard is not a seam, it is a hole.
  local deadline=40
  # 🛑 COMPARED NUMERICALLY, NOT AS A STRING. An earlier version refused the
  # literal "0" and any value containing a non-digit, and its comment claimed the
  # hole was closed. It was not: "00" and "000" are digits-only and are not
  # string-equal to "0", so they reached `curl -m 00`, which means NO TIMEOUT.
  # Measured against a never-answering server: `-m 2` returns rc=28 in ~2s,
  # `-m 00` was still running after 6. `10#` forces base 10 so a leading zero is
  # not read as octal.
  case "${KOSMOS_CONN_TIMEOUT:-}" in
    "") : ;;
    *[!0-9]*) : ;;          # not digits-only: ignore it, keep the ceiling
    *) local _t=$((10#$KOSMOS_CONN_TIMEOUT))
       # 🛑 A BAND, NOT JUST "> 0". An earlier version closed every spelling of
       # zero and left the high side wide open: KOSMOS_CONN_TIMEOUT=999999 reached
       # `curl -m 999999`, about 11.5 days, which removes the ceiling exactly as
       # `-m 0` does and makes the timeout sentence below unreachable by the same
       # route. Same failure, opposite end, and the guard's own comment claimed to
       # prevent it. 300 is well past any honest local sweep and far short of a
       # hang. Anything outside the band keeps the 40s default.
       # ⚠️ ASSIGN THE VALUE THAT WAS VALIDATED, not the raw one. The band checks
       # $_t (base-10 normalised) and an earlier version then assigned the RAW
       # string, so the value tested and the value used were not the same thing:
       # a 22-digit "0000000000000000000005" passes the band as 5 and reached
       # `curl -m 0000000000000000000005`. Harmless with today's curl, and the
       # gap between checked and used is the part worth closing.
       [ "$_t" -ge 1 ] && [ "$_t" -le 300 ] && deadline="$_t" ;;
  esac
  # `-s` alone, not `-sS`: the comment above says stderr is discarded on purpose,
  # and `-S` exists solely to print errors there. Keeping both states an intent
  # the redirect immediately contradicts. We branch on the EXIT CODE, not output.
  body=$(curl -s -m "$deadline" "$URL/api/agent/connections" 2>/dev/null) || {
    rc=$?
    # 28 is curl's own timeout. Saying "Kosmos did not answer" for a client-side
    # deadline blames the board for our impatience and sends the reader to the
    # wrong place.
    if [ "$rc" -eq 28 ]; then
      say "Checking what is connected took longer than we waited. The board is running; try again, or open it at $URL"
    else
      say "Kosmos did not answer, so we cannot tell you what is connected on this computer."
    fi
    exit 1
  }
  if [ ! -x "$NODE" ]; then
    # The runtime is how we PRINT the answer, not how we get it. Losing it
    # should cost formatting, not the answer, so the raw body goes out rather
    # than a locally-invented sentence. Same rule `whoami` states.
    # Control characters stripped here too. The renderer below strips them because
    # this output lands in the context window of an agent, and that argument does
    # not stop applying just because the runtime is missing. The trade this path
    # makes is losing FORMATTING, not the answer.
    # ⚠️ NOT THE IDENTICAL CLASS, and the comment used to claim it was. `tr` is
    # byte-oriented, so this strips C0 and DEL; the node renderer also strips C1
    # (U+0080-U+009F), which is multi-byte in UTF-8 and cannot be expressed here.
    # Practically negligible, and worth saying accurately rather than claiming the
    # two paths give the same guarantee when one is narrower.
    printf '%s\n' "$body" | tr -d '\000-\010\013\014\016-\037\177'
    # 🛑 THE STATUS STILL HAS TO BE HONEST. Printing the raw body when we cannot
    # format it is the stated trade above and stays. Reporting SUCCESS for a call
    # that FAILED is not part of that trade, and this was doing both: a board
    # answering {"error": ...} left here with exit 0, so anything branching on the
    # status saw a healthy call. Measured: no-runtime on a 404 body printed the
    # raw JSON and returned 0, while the formatted path returned 1 for the same
    # board.
    # ⚠️ Keyed on the error FIELD rather than parsed, because parsing is exactly
    # what we do not have a runtime for. It is a narrower test than the renderer
    # does and it is the honest one available here.
    case "$body" in *'"error"'*) return 1 ;; esac
    return 0
  fi
  # The board composed every sentence; this prints them rather than inventing
  # its own, the same rule `whoami` states.
  # The resolved restart command goes in through the ENVIRONMENT, the same shape
  # line 433 already uses for KOSMOS_PKG. It cannot be interpolated into the
  # script text: that is a single-quoted shell string, and a path with an
  # apostrophe in it would end the script (which is what the apostrophe guard
  # test in this file exists to catch).
  printf '%s\n' "$body" | KOSMOS_RESTART_CMD="\"$SELF\" restart" "$NODE" -e '
    /* 🛑 CONTROL CHARACTERS STRIPPED FROM EVERY WIRE STRING BEFORE IT IS PRINTED.
       This output does not only land on a terminal, it lands in the CONTEXT
       WINDOW OF AN AGENT: this branch splices the connections verb into every
       agent instruction file. So an escape sequence repaints the screen, and
       instruction-shaped text arrives exactly where instructions are read.
       Our own boundary allowlists every string it emits, so nothing from OUR
       board can carry these. That is precisely the assumption this block refuses
       to make everywhere else: it type-guards, own-property checks and filters
       because the board may be a different build than the CLI.
       ⚠️ DECLARED AT THE TOP, OUTSIDE EVERY BRANCH, AND THE POSITION IS LOAD
       BEARING. It sat ~55 lines below its first caller once, so v.error printed
       uncleaned; moved into the error branch it was hoisted-but-unassigned on the
       happy path and threw for 18 tests. var hoists the NAME, never the value.
       NOTE no apostrophe anywhere in this comment. This whole renderer is a
       single-quoted shell string and one apostrophe ends the program. */
    var clean = function (x) { return typeof x === "string" ? x.replace(/[\u0000-\u001f\u007f-\u009f]/g, " ") : x; };
    /* setEncoding, because `raw += d` on a Buffer does an implicit per-chunk
       toString: a multi-byte UTF-8 character split across a chunk boundary is
       corrupted and JSON.parse then fails, degrading to "we could not read".
       An error listener for the same reason the rest of this block exists: an
       unhandled stdin error throws a stack with absolute paths at the reader,
       which is the machine vocabulary these fifty lines refuse. Both unreachable
       from this board, both free. */
    process.stdin.setEncoding("utf8");
    process.stdin.on("error", function () { console.log("Kosmos answered something we could not read, so we cannot say what is connected."); process.exitCode = 1; });
    let raw = ""; process.stdin.on("data", (d) => { raw += d; });
    process.stdin.on("end", () => {
      let v = null;
      try { v = JSON.parse(raw); } catch { v = null; }
      if (v && typeof v.error === "string") {
        /* 🛑 PRINT THE BOARD SENTENCE ONLY WHEN IT COMPOSED ONE FOR A PERSON. A board
           that PREDATES this route falls through to a generic
           `{"error":"no such endpoint"}`, and printing that verbatim puts
           developer vocabulary on screen with no next step -- in a verb that
           refuses machine vocabulary two lines up. The window is real: an
           install replaces this file while the running board is still the old
           process.
           NOTE: no apostrophes in this embedded script. It lives in a
           single-quoted shell string and one apostrophe ends the file. */
        if (/no such endpoint/i.test(v.error)) {
          console.log("This copy of Kosmos does not know how to answer that yet.");
          console.log("The board is running an older version. Restart it with: " + (process.env.KOSMOS_RESTART_CMD || "kosmos restart"));
        } else {
          console.log(clean(v.error));
        }
        /* ⚠️ exitCode + return, NEVER process.exit, AFTER PRINTING. stdout is
           ASYNCHRONOUS when it is a pipe, and process.exit does not wait for a
           pending write, so the sentence can be dropped and the status kept. In
           the one verb whose stated job is to always say something rather than
           nothing, losing the sentence and keeping the 1 is the worst of both.
           Latent rather than live (these messages are short), and this is the
           form that cannot drop it. */
        process.exitCode = 1;
        return;
      }
      /* 🛑 THE ELEMENTS, NOT ONLY THE CONTAINER. `[null]` passed this guard and
         then threw on `.signedIn`, printing a TypeError and a full stack with absolute
         paths at somebody who asked what was connected -- the most machine-vocabulary
         output this verb can produce, in the verb whose whole job is refusing it, and
         AFTER the header had already reached stdout. */
      if (!v || !Array.isArray(v.providers)
          || v.providers.some(function (p) { return !p || typeof p !== "object"; })) {
        console.log("Kosmos answered something we could not read, so we cannot say what is connected.");
        /* exitCode + return, not process.exit: stdout is async on a pipe and
           process.exit does not wait for the write. See the v.error arm above. */
        process.exitCode = 1;
        return;
      }
      /* 🛑 THE HEADER IS GATED ON THE FILTERED LIST, NOT ON THE RAW ONE, for the
         same reason the services header below is: a heading over nothing "reads
         as a section that failed to load rather than one with nothing to say".
         Measured before the gate: a board answering `providers: []` printed the
         heading, a blank line, and nothing, AT EXIT 0, so an agent branching on
         status was told the call succeeded. The container guard above catches a
         null element; it cannot catch an empty list or one whose every row the
         string guard drops.
         ⚠️ THIS IS NOT REACHABLE FROM OUR OWN BOARD (`forAgent` always returns
         exactly two providers). It is guarded because this whole block exists to
         tolerate a board it does not control, which is precisely the argument
         that got the services half guarded one screen below. */
      var okProviders = v.providers.filter(function (p) {
        return p && typeof p.name === "string" && typeof p.because === "string";
      });
      if (!okProviders.length) {
        console.log("Kosmos answered something we could not read, so we cannot say what is connected.");
        /* exitCode + return, not process.exit: stdout is async on a pipe and
           process.exit does not wait for the write. See the v.error arm above. */
        process.exitCode = 1;
        return;
      }
      console.log("What this computer is connected to:");
      console.log("");
      /* Own-property lookups on every wire-supplied key. A board answering
         signedIn "constructor" made this print
         `function Object() { [native code] }` at a person, which is the same
         prototype-chain class the engine boundary closed one file away, in the
         verb whose stated job is refusing machine vocabulary. */
      var own = function (o, k) { return Object.prototype.hasOwnProperty.call(o, k) ? o[k] : undefined; };
      var SAY = { connected: "connected", none: "not connected", unknown: "could not check" };
      for (const p of okProviders) {
        /* ⚠️ STRINGS ONLY, for the same reason as the services loop below:
           a board answering name or because as an object printed
           "[object Object]: connected ([object Object])" at a person. Measured,
           exit 0, so nothing signalled it. The boundary allowlists both fields,
           so this is the CLI refusing to trust a board it does not control. */
        /* Redundant with `okProviders` by construction and kept deliberately: it is
           the same predicate, and a future edit that widens one without the other
           is caught here rather than printing an object at a person. */
        if (!p || typeof p.name !== "string" || typeof p.because !== "string") continue;
        // `none` and `unknown` are machine vocabulary. A person reads this.
        var verdict = own(SAY, p.signedIn) || "could not check";
        /* 🛑 THE COUNT THAT WORKS, NOT THE COUNT THAT EXISTS. "3 sign-ins" beside
           "has a working sign-in" reads as three working ones. Say both only when
           they differ, and say nothing at all when we could not look
           (`null`), because a number beside "could not check" reads as settled.
           `!= null` on purpose: an older board that omits the field entirely
           must be treated as "did not say", not as "0". */
        var many = "";
        /* NUMBERS ONLY, same reason as the strings guard above: these three feed
           arithmetic and then a sentence, so a non-number reaches a person as
           machine vocabulary. `typeof` rather than `!= null` keeps the older-board
           case intact, because a board that OMITS the field is undefined, which is
           not a number, and so is still treated as did not say rather than as 0. */
        if (typeof p.howMany === "number") {
          var w = typeof p.howManyWorking === "number" ? p.howManyWorking : p.howMany;
          /* The denominator is the READABLE rows, not every row. A row whose
             live check we could not read is neither working nor broken, and
             counting it against the person is a settled negative about
             something nobody looked at. */
          var m = typeof p.howManyReadable === "number" ? p.howManyReadable : p.howMany;
          /* ⚠️ THE ZERO CASE RETURNS EARLY RATHER THAN FALLING THROUGH. It used to
             set `many = ""` and then meet an UNCONDITIONAL append below, so a board
             reporting a negative `howManyReadable` re-armed the very text the zero
             case exists to suppress. Unreachable from honest data (howMany === 0
             implies m === 0), but two lines encoding opposite intents is exactly
             what this block is here to prevent, and the next edit inherits it. */
          if (p.howMany === 0) {
            many = "";
          } else {
            /* w cannot exceed m. Each falls back to p.howMany independently, so a
               version-skewed board sending howManyWorking above howManyReadable
               rendered "3 of 1 sign-ins working" at a person. Unreachable from
               this board; the block guards several equally unreachable shapes for
               the stated reason that the CLI does not control the board, so this
               was the odd omission rather than a new policy. */
            /* 🛑 CLAMP THE DENOMINATOR FIRST, THEN THE NUMERATOR AGAINST IT.
               An earlier version of this comment said "clamp BOTH ends" and clamped
               only `w`, leaving `m` free. Measured with a board answering
               howManyReadable -1: ", 0 of -1 sign-ins working, 2 we could not
               check" - a NEGATIVE denominator, and an unchecked count larger than
               the total. The comment claimed coverage it did not have, which on
               this branch is the defect itself rather than a nit.
               Unreachable from our own boundary; every neighbouring guard in this
               block exists for a version-skewed board the CLI does not control,
               which is what made this the odd omission. */
            if (m < 0) m = 0;
            if (w > m) w = m;
            if (w < 0) w = 0;
            /* "working" even when the two numbers match. Dropping it is accurate
               and reintroduces the exact ambiguity recorded above: "3 sign-ins"
               beside "has a working sign-in for it" is what read as three working
               ones. A reader cannot know the numbers matched. One word. */
            if (w === m) many = ", " + (w === 1 ? "1 sign-in working" : w + " sign-ins working");
            else many = ", " + w + " of " + m + (m === 1 ? " sign-in working" : " sign-ins working");
            if (p.howMany > m) many = many + ", " + (p.howMany - m) + " we could not check";
          }
        }
        /* 🛑 `installed` WAS COMPUTED AND NEVER RENDERED. The boundary emits it as a
           careful three-state field, and the runner-key mapping exists so it can be
           right, but no consumer read it: grep of this file for `installed` returned
           0 against a control of 7 for other provider fields. So a working sign-in
           beside a MISSING PROGRAM printed as a bare "connected", and the agent this
           branch recruits to run the verb was never told the program was gone. The
           only not-installed sentence in the module is reachable when the state is
           `none`, because `connected` short-circuits above it.
           ⚠️ ONLY ON `false`, NEVER ON `null`. `null` is "we could not look", and a
           confident "not installed" there is exactly the collapse the three-state
           rule refuses, one field over. */
        /* ⚠️ NOT WHEN THE STATE IS ALREADY `none`. saysFor() ALREADY returns the
           not-installed sentence as `because` for none + not-installed, which is
           the FRESH MACHINE case this card exists for, so appending here printed
           it TWICE in exactly the situation that matters most:
             Claude: not connected (the program it needs is not installed...). The
             program it needs is not installed on this computer yet
           The comment on the previous version reasoned that the module sentence
           "is reachable when the state is none" and then appended unconditionally,
           so the two overlapped precisely there.
           🛑 AND 31 CLI TESTS RENDERED THE DUPLICATE WITHOUT NOTICING, because the
           GPT row in the shared fixture is exactly none + not-installed and nothing
           asserted against it. The arm I did write covered connected plus
           not-installed, where the suffix genuinely adds information.
           NOTE no apostrophe in this comment. Writing one here terminated the
           single-quoted shell string and broke 28 tests, which is the third time
           tonight and precisely what the apostrophe guard below exists to catch. */
        var missing = (p.installed === false && p.signedIn !== "none") ? ". The program it needs is not installed on this computer yet" : "";
        console.log("  " + clean(p.name) + ": " + verdict + " (" + clean(p.because) + many + ")" + missing);
      }
      /* 🛑 STUCK AND INTERRUPTED ARE NOT BUSY, AND THEY ARE THE TWO MOMENTS AN
         AGENT IS MOST USEFUL. Printing only on `busy` dropped both silently, so
         a person whose sign-in is stuck got an agent that said nothing about it. */
      var STOPPED = { stuck: "An earlier sign-in got stuck and did not finish.",
                      interrupted: "An earlier sign-in was interrupted before it finished." };
      /* 🛑 PAST TENSE, AND SUPPRESSED WHEN A PROVIDER IS ACTUALLY CONNECTED.
         connect.state() returns a persisted stuck/connected from a PREVIOUS board
         process with no freshness gate once startedOnce is false, which is the
         state at every board boot. So after a restart this could print
         "Claude: connected" and then "a sign-in got stuck", in the present tense,
         about the same machine. Two accounts of one computer is the exact thing
         this whole verb exists to avoid. */
      /* SCOPED TO THE PROVIDER THE FLOW BELONGS TO. v.signin covers the Claude
         download-and-sign-in flow only. Suppressing on ANY connected provider
         meant a machine with GPT connected and Claude genuinely stuck RIGHT NOW
         printed nothing at all, which is the same silence the block above exists
         to remove. The staleness argument only ever justified suppressing on a
         connected CLAUDE.
         NOTE: no apostrophes anywhere in this embedded script. It is wrapped in
         a single-quoted shell string, so one apostrophe ends the string and the
         file stops parsing. bash -n caught exactly that here. */
      var who = (v.signin && v.signin.provider) || "anthropic";
      /* 🛑 NAME THE PROVIDER IN THE SENTENCE. `who` was computed and used only
         for the suppression test, so the line read unqualified beside a
         two-provider list: an agent helping with a GPT key read "a sign-in is
         going on right now" and attached it to GPT, while the flow belonged to
         Claude.
         That is the two-accounts-of-what-to-do failure the provider field was
         added to prevent, surviving one layer further out. */
      var whoRow = v.providers.filter(function (p) { return p.id === who; })[0];
      /* ⚠️ typeof, NOT truthiness, and the difference is a whole class of output.
         The strings guard added to the provider loop above is a `continue` INSIDE
         that loop; `whoName` is computed OUT here from the same unvalidated field,
         so the guard never covered it. Measured against a board answering
         `providers[0].name = {}` with a stuck phase, the three sentences below
         printed "An earlier [object Object] sign-in got stuck and did not finish."
         A non-string name is truthy, so `||` accepted it and the fallback never
         fired -- the fallback was there and simply did not apply. */
      /* 🛑 RESOLVED IS ITS OWN FACT. The comment below says one resolved row drives
         both, and it did not: when `signin.provider` matches NO row, `whoRow` is
         undefined, so `whoName` fell back to "Claude" while `anyConnected` fell back
         to false. MEASURED against a board answering provider "gemini" phase "stuck"
         with the anthropic row connected, the output was "Claude: connected (...)"
         followed by "An earlier Claude sign-in got stuck" -- the two-accounts-of-one
         computer contradiction, produced by the fallback meant to prevent it.
         (Control: the same payload with provider "anthropic" suppressed the stuck
         line correctly, so the instrument can produce the safe answer.)
         ⇒ An unresolved provider means we do not know WHOSE sign-in it is. We say
         so by not attributing it, rather than by guessing a name. */
      var whoResolved = !!whoRow;
      /* ⚠️ CLEANED AT THE ASSIGNMENT so all three sign-in sentences inherit it.
         The provider loop cleans this same field; whoName is computed OUT HERE
         from the same unvalidated value and reached three console.log calls
         uncleaned. That is the SECOND time this exact field has leaked past a
         guard that lived inside the loop: the typeof check had the same shape.
         Fixing it at the source is what stops a third sentence inheriting it. */
      var whoName = clean((whoRow && typeof whoRow.name === "string" && whoRow.name) || "Claude");
      /* 🛑 ONE RESOLVED ROW DRIVES BOTH, BECAUSE TWO FALLBACKS FOR ONE VALUE
         DISAGREED. `whoName` fell back to "Claude" on an unrecognised provider while
         this stayed false, so a board answering an unknown provider printed BOTH
         "Claude: connected" AND "An earlier Claude sign-in got stuck" -- the
         two-accounts-of-one-computer contradiction the comment above says this block
         exists to prevent, produced by the fallback meant to prevent it.
         ⚠️ Not reachable from this board, whose signinView hard-codes the
         provider. It matters because the CLI updates independently of the running
         board and the test in this file commits to tolerating a board it does not
         control. */
      var anyConnected = !!(whoRow && whoRow.signedIn === "connected");
      /* 🛑 THREE ANSWERS, NEVER TWO, AND THIS SECTION COLLAPSED TO TWO. An
         `unknown` phase fell through both branches and printed NOTHING, which is
         byte-identical to `idle`. So "no sign-in is going on" and "we could not
         tell whether one is" were indistinguishable to the agent reading it, the
         exact collapse the null count one layer up exists to prevent. */
      /* 🛑 GATED ON !anyConnected, THE SAME AS THE STOPPED BRANCH BELOW, AND THIS
         GATE WAS MISSING WHILE THE OTHER ONE WAS NOT. The module now rewrites a
         stale terminal phase to "unknown" when the provider reads connected, so
         the record that USED to arrive as "stuck" and be suppressed here by the
         STOPPED gate now arrives as "unknown" and landed in this branch, which
         had no gate. The result was printed side by side on one screen:
             Claude: connected (this computer has a working sign-in for it)
             We could not tell whether a Claude sign-in is going on.
         A settled answer and an uncertainty about the same provider, which is the
         contradiction this whole verb exists to refuse.
         ⚠️ THE RULE MOVED INWARD AND ONLY HALF ITS SCOPE MOVED WITH IT, for the
         second time on this branch. The first time it was provider scope; this
         time it is which BRANCH the rewritten value lands in. Moving a rule is
         not finished until every consumer of the OLD value is checked. */
      if (v.signin && v.signin.phase === "unknown" && !anyConnected) {
        console.log("");
        console.log("  We could not tell whether " + (whoResolved ? ("a " + whoName) : "a") + " sign-in is going on. Ask what is on their screen.");
      /* ⚠️ ONE replace, not two. The first was `.replace("A sign-in", ...)` and it
         was DEAD: measured, 0 of the 2 STOPPED values contain that substring and
         both contain "An earlier sign-in" (control: "got stuck" matches 1). Dead
         code that looks live is a trap, because a reader concludes both shapes are
         handled. If a STOPPED value is ever added that does NOT begin "An earlier
         sign-in", it will print without the provider name and this needs revisiting. */
      } else if (v.signin && own(STOPPED, v.signin.phase) && !anyConnected) {
        console.log("");
        console.log("  " + (whoResolved ? own(STOPPED, v.signin.phase).replace("An earlier sign-in", "An earlier " + whoName + " sign-in") : own(STOPPED, v.signin.phase)) + " Ask what is on their screen.");
      } else if (v.signin && v.signin.busy) {
        // The phase is machine vocabulary too, exactly like the verdicts above.
        // An unmapped phase falls back to a sentence with no jargon in it
        // rather than printing the raw token at somebody.
        var STEP = {
          "downloading": "it is downloading the program it needs",
          "installing": "it is installing the program it needs",
          "signin-launching": "it is opening the sign-in",
          "signin-browser-open": "the sign-in is open in their browser",
          "signin-awaiting-code": "it is waiting for them to paste the code",
          "signin-completing": "it is finishing the sign-in"
        };
        console.log("");
        console.log("  " + (whoResolved ? ("A " + whoName) : "A") + " sign-in is going on right now: " + (own(STEP, v.signin.phase) || "it is part way through")
          + ". Ask what is on their screen.");
      }
      /* Gate on the FILTERED rows, not the raw length. The loop below drops
         non-string rows, so a board answering only malformed services printed
         the "Other services:" header with nothing underneath it, which reads as
         a section that failed to load rather than one with nothing to say. */
      var okServices = (Array.isArray(v.services) ? v.services : []).filter(function (s) {
        return s && typeof s.name === "string" && typeof s.because === "string";
      });
      if (okServices.length) {
        console.log("");
        console.log("Other services:");
        /* ⚠️ STRINGS ONLY. A service row whose name or reason is an object
           rendered as "[object Object]: [object Object]" at a person. The boundary
           allowlists these, so this is the CLI refusing to trust a board it does not
           control, which is the same reason the guard above checks elements. */
        for (const s of okServices) {
          console.log("  " + clean(s.name) + ": " + clean(s.because));
        }
      }
      console.log("");
      console.log("You cannot see their screen. Ask what it says rather than guessing.");
    });
  '
}

# ---- kosmos report <state> [--on <what>] [--owner <who>] [--until <when>] [--project <project-id>] [words…]
# Say what you are DOING. Records rather than delivers (#188's third verb):
# nothing is typed anywhere and nobody is interrupted; the board reads the
# record instead of scraping your screen. The states are the six words from
# #253: started, working, idle, needs_you, blocked, stopped.
#
# ⚠️ NO RECIPIENT AND NO SENDER ARGUMENT, the same property as reply: the
# sender is derived rather than named, so an agent cannot report AS SOMEBODY
# ELSE BY ASKING TO. That is what makes the record evidence rather than typing.
#
# 🛑 THIS USED TO SAY "an agent can only ever report as itself", which reads as
# unforgeable and is stronger than the code. A pane id is enumerable with
# `tmux list-panes` and the board has no auth, so a local process can pass
# another agent's pane. The `/api/reply` comment has said so for a while; this
# was the FIFTH copy of the old wording and the last one found (#570). It
# survived an earlier sweep because that sweep filtered on file extensions and
# this file has none.
#
# --auto marks a report the MACHINE wrote on the agent's behalf (a lifecycle
# hook), not one the agent chose to send. An automatic `idle` will not erase a
# standing `blocked` or `needs_you` (#900).
cmd_report() {
  local state text body because on="" owner="" until="" project="" auto=0
  state="${1:-}"
  shift 2>/dev/null || true
  # Bash 3.2 flag loop: the three optional fields blocked carries, and the
  # project a report is about (#763). Anything else is the sentence.
  while [ $# -gt 0 ]; do
    case "$1" in
      --on)    on="${2:-}";    shift 2 2>/dev/null || break ;;
      --owner) owner="${2:-}"; shift 2 2>/dev/null || break ;;
      --until) until="${2:-}"; shift 2 2>/dev/null || break ;;
      --project) project="${2:-}"; shift 2 2>/dev/null || break ;;
      --auto)  auto=1;          shift 1 2>/dev/null || break ;;
      *) break ;;
    esac
  done
  text="$*"
  if [ -z "$state" ]; then
    say "Usage: kosmos report <started|working|idle|needs_you|blocked|stopped> [--on <what>] [--owner <who>] [--until <when>] [--project <project-id>] [--auto] [what you want to say about it]"
    exit 2
  fi
  if ! healthy; then
    say "Kosmos is not running, so this could not be recorded. Start it with: kosmos start"
    exit 1
  fi
  # Same hand-rolled JSON escaping as cmd_msg, same bash-3.2 reason.
  local esc_state esc_text esc_on esc_owner esc_until esc_pane
  esc_state=$(printf '%s' "$state" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_text=$(printf '%s' "$text" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_on=$(printf '%s' "$on" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_owner=$(printf '%s' "$owner" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_until=$(printf '%s' "$until" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_project=$(printf '%s' "$project" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  esc_pane=$(printf '%s' "${TMUX_PANE:-}" | tr '\n\t\r' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g')
  # ⭐ PRESENT THE LAUNCH TOKEN IF KOSMOS GAVE US ONE (#570 step 1.5).
  # `bin/agent-supervisor.sh` mints per launch and exports KOSMOS_AGENT_TOKEN
  # into the pane (#1077); `server.js` accepts it on /api/report and
  # /api/reply (#1117). NOTHING READ IT BACK OUT. Kosmos minted a credential,
  # put it in the environment, and no client ever presented it -- so the
  # token arm has carried zero traffic since it merged, and would have carried
  # zero after any number of restarts.
  #
  # 🛑 ONLY A HEX TOKEN IS SENT. An empty or malformed value is dropped rather
  # than forwarded: /api/report reads `header || body.token`, so a junk header
  # would take the token arm and fail there instead of falling through to the
  # pane, turning a working report into a refused one.
  _tok=""
  case "${KOSMOS_AGENT_TOKEN:-}" in
    ''|*[!0-9a-f]*) ;;
    *) _tok="$KOSMOS_AGENT_TOKEN" ;;
  esac
  body=$(curl -sS -m 15 -X POST "$URL/api/report" \
    -H 'content-type: application/json' \
    ${_tok:+-H "x-kosmos-agent-token: $_tok"} \
    --data "{\"state\":\"$esc_state\",\"text\":\"$esc_text\",\"on\":\"$esc_on\",\"owner\":\"$esc_owner\",\"until\":\"$esc_until\",\"project\":\"$esc_project\",\"auto\":$([ "$auto" = 1 ] && printf 'true' || printf 'false'),\"from_pane\":\"$esc_pane\"}" 2>/dev/null) || {
    say "We could not reach Kosmos to record that. Is it running at $URL?"
    exit 1
  }
  case "$body" in
    *'"error"'*)
      because=$(printf '%s' "$body" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')
      say "Kosmos refused that: ${because:-it did not say why}."
      exit 1 ;;
    *'"recorded":true'*)
      # What this can claim and the LIMIT of it (the same discipline as
      # reply's sentence): the report is in the record the board reads.
      # Whether anybody is looking is not ours to say.
      say "Recorded. The board reads it from here."
      ;;
    *)
      because=$(printf '%s' "$body" | sed -n 's/.*"because":"\([^"]*\)".*/\1/p')
      say "That was not recorded: ${because:-we could not tell why}."
      exit 1 ;;
  esac
}

cmd_restart() {
  # The point is that start then runs the code that is on disk NOW, which
  # is what an update needs. The `|| true` tolerates "was not running";
  # it can NOT tolerate the stranger-on-the-port case, because that branch
  # of stop exits the process outright -- and that is correct here too:
  # a port owned by something we refuse to kill is a port start cannot
  # bind, so continuing would only move the failure one line down.
  cmd_stop || true
  cmd_start
}

# Read a project room's recent talk (#314): the tail, oldest first, shaped by
# the server (?as=text) because stock bash has no JSON parser. This is the
# command an agent brought in after a valve is taught, so it must work with
# nothing but curl.
cmd_room() {
  local project
  project="${1:-}"
  if [ -z "$project" ]; then
    say "Usage: kosmos room <project-id>   (project ids are in your instructions' Your projects section)"
    exit 2
  fi
  if ! healthy; then
    say "Kosmos is not running, so the room cannot be read. Start it with: kosmos start"
    exit 1
  fi
  local esc_project
  esc_project=$(printf '%s' "$project" | sed "s/[^A-Za-z0-9._-]//g")
  if ! curl -sS -m 15 "$URL/api/project/$esc_project/room?as=text" 2>/dev/null; then
    say "We could not reach Kosmos to read that room. Is it running at $URL?"
    exit 1
  fi
}

# ⭐ ONE-TIME ADOPTION (#570). Josh ruled it 2026-08-27: mint once for agents
# Kosmos can already vouch for, then strict from then on.
#
# 🛑 DRY RUN BY DEFAULT. `--confirm` is the whole safety design: a one-time
# widening of trust that can happen by mistyping is not one-time. Nothing else
# may call this -- not a hook, not startup, not a sync. A sync minting ids for
# all seventeen agents as a side effect is not hypothetical; it happened on
# 2026-08-26 at 23:17.
cmd_adopt() {
  local confirm=0
  case "${1:-}" in
    --confirm) confirm=1 ;;
    "") ;;
    *) say "kosmos adopt [--confirm]"; exit 2 ;;
  esac
  if [ ! -x "$NODE" ] || [ ! -d "$KOSMOS_HOME/app" ]; then
    say "Kosmos cannot find its own runtime, so it cannot vouch for anything."
    exit 2
  fi
  KOSMOS_ADOPT_CONFIRM="$confirm" KOSMOS_ADOPT_BY="${USER:-unknown}" \
  "$NODE" -e '
    const base = process.argv[1];
    const status = require(base + "/engine/status");
    const adopt  = require(base + "/engine/adopt");
    let rows;
    try { rows = status.paneRoster(); }
    catch (e) {
      /* paneRoster THROWS when tmux could not be asked, rather than answering
         "no agents". Adoption must refuse there: vouching for a machine we
         cannot see is the one thing this must never do. */
      console.log("could not read the agents on this computer, so nothing was vouched for.");
      process.exit(2);
    }
    const p = adopt.plan(rows);
    if (!p.eligible.length) {
      console.log("nothing to adopt: " + p.skipped.length + " agent(s) already have provenance or are not ours.");
      for (const s of p.skipped) console.log("  skip " + s.name + " -- " + s.because);
      process.exit(0);
    }
    console.log(p.eligible.length + " agent(s) would be adopted:");
    for (const e of p.eligible) console.log("  " + e.name);
    for (const s of p.skipped) console.log("  skip " + s.name + " -- " + s.because);
    if (process.env.KOSMOS_ADOPT_CONFIRM !== "1") {
      console.log("");
      console.log("Nothing was written. Run: kosmos adopt --confirm");
      process.exit(0);
    }
    const done = adopt.apply(rows, process.env.KOSMOS_ADOPT_BY);
    for (const d of done) console.log((d.ok ? "  adopted " : "  FAILED  ") + d.name + (d.ok ? " (" + d.instance + ")" : " -- " + d.because));
    const bad = done.filter((d) => !d.ok).length;
    process.exit(bad ? 1 : 0);
  ' "$KOSMOS_HOME/app"
}

case "${1:-}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  open)    cmd_open ;;
  agents)  cmd_agents ;;
  adopt)   shift; cmd_adopt "$@" ;;
  version) cmd_version ;;
  msg)     shift; cmd_msg "$@" ;;
  reply)   shift; cmd_reply "$@" ;;
  post)    shift; cmd_post "$@" ;;
  report)  shift; cmd_report "$@" ;;
  connections)
    shift
    # It takes no arguments, and answering as though it did is expensive: the
    # sweep behind it is a subprocess per Claude account plus an authenticated
    # request per OpenAI account. `kosmos connections --help` used to pay all of
    # that and then print the report anyway.
    # --help is answered from the refusal branch itself: it costs nothing, and
    # refusing a request for help with an error is the one refusal that reads as
    # the tool being broken rather than the caller being wrong.
    case "${1:-}" in
      --help|-h)
        say "connections: say what this computer is connected to."
        say "Takes no options. Run: \"$SELF\" connections"
        exit 0 ;;
    esac
    if [ "$#" -gt 0 ]; then
      say "\"connections\" takes no options. Run: \"$SELF\" connections"
      exit 2
    fi
    cmd_connections ;;
  whoami)  shift; cmd_whoami "$@" ;;
  room)    shift; cmd_room "$@" ;;
  *)
    printf '\n  kosmos start | stop | restart | status | open | agents | connections | version | msg | post | reply | report | room | whoami\n\n'
    printf '  The dashboard lives at %s once started.\n\n' "$URL"
    exit 2
    ;;
esac
