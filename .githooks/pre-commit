#!/bin/sh
# Refuse a commit that adds, renames or deletes a browser check without the
# README row moving with it (#612). The suite's browser-checks-indexed test
# already asserts this, but a PR can merge green on a subset of the suite and
# leave MAIN red on the next full run; the PR that broke it is then not the PR
# that fails. This runs the one guard, in milliseconds, at the moment the
# change is being made, so the adding change is the one that hears about it.
#
# Wire it once per clone (worktrees inherit it, and the path resolves inside
# each worktree):   git config core.hooksPath .githooks
set -eu

# --- $? after a pipe is the LAST command's status (#632) ----------------------
# `yarn test | tail -5; [ $? -eq 0 ]` reads tail's status, which is always 0,
# so a failing suite reads as green. Five of us shipped or nearly shipped on
# that in one day; every instance failed toward green, and a wrong green
# ships. This refuses a staged shell file where a pipe into a filter is
# followed within two lines by `$?`, and the `grep -c ... || echo 0` variant
# (it prints "0\n0" when grep finds nothing, and breaks the arithmetic after
# it). A file that has turned on `pipefail` above the line is not flagged:
# under pipefail `$?` is the rightmost failing status, which is the point.
# Want the left side's status without pipefail? Read `${PIPESTATUS[0]}` on
# the very next line, or write to a file, check the status, then read it.
shape_reds=0
for f in $(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(sh|bash)$|^install/kosmos$|^\.githooks/' || true); do
  [ -f "$f" ] || continue
  # kosmos#4911: the program sits between these two markers so tools/test-precommit-pipe-lint-4911.sh runs THIS text.
  # PIPE-LINT-BEGIN
  hits="$(git show ":$f" | awk '
    # own(l): l is "<one simple command>; var=<exit status>", so that status is the command'"'"'s own and a pipe on an
    # earlier line cannot reach it. Everything before the ";" must be ONE simple command: no other ";", "&&" or "||"
    # (the status would be the last segment'"'"'s), no pipe, no comment, no status read, balanced quotes, and a first word
    # (after any VAR=x prefixes) that is a plain command: not a keyword or closer, not a builtin that always succeeds,
    # not a wrapper of another command, not a sourced file. Assignments alone run no command, so own nothing.
    # (These comments never write the status variable itself: this hook lints its own text.)
    function own(l,   i, w, pre, t, t2) {
      if (l !~ /^[[:space:]]*[A-Za-z_.\/]/) return 0
      i = match(l, /;[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=\$\?/)
      if (!i) return 0
      pre = substr(l, 1, i - 1)
      if (pre ~ /;|&&|\|\||\$\?/) return 0                     # more than one command, or a status read first
      if (pre ~ /\|/) return 0                                 # a pipe of its own (any filter)
      if (pre ~ /(^|[[:space:]])#/) return 0                   # the ";" is inside a comment
      t = pre; if (gsub(/"/, "", t) % 2) return 0
      t = pre; if (gsub(/'"'"'/, "", t) % 2) return 0
      # Strip leading assignments (scalars, arrays, +=, elements, quoted, arithmetic, $()) to reach the command word.
      t = pre
      while (sub(/^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?\+?=(\([^)]*\)|("[^"]*"|'"'"'[^'"'"']*'"'"'|\$\(\([^)]*\)\)|\$\([^)]*\)|[^[:space:]"'"'"'(\\]+)*)/, "", t)) { }
      if (t ~ /^[[:space:]]*$/) {                              # assignments alone: owned only if one ran a command
        t2 = pre; gsub(/\$\(\(/, "", t2)                         # arithmetic $(( )) runs no command
        return (t2 ~ /\$\(|`/) ? 1 : 0
      }
      w = t; sub(/^[[:space:]]*/, "", w); sub(/[^A-Za-z0-9_.\/-].*$/, "", w)
      if (w == "") return 0
      if (w ~ /^(done|fi|esac|then|else|elif|do|if|for|while|until|case|select|function|wait)$/) return 0
      if (w ~ /^(local|declare|typeset|readonly|export|set|unset|shift|true|alias|unalias|builtin|command|eval|exec|time|echo|printf|trap|hash|ulimit|shopt|umask|pushd|popd|dirs|enable|getopts|let)$/) return 0
      if (w ~ /^(sudo|env|nice|nohup|xargs|timeout|stdbuf|caffeinate)$/) return 0
      if (w ~ /^(source|\.)$/) return 0
      return 1
    }
    function closes(l,   a, o, c) {
      a = l; gsub(/\$\{/, "", a); o = gsub(/[({]/, "", a)
      a = l; gsub(/\$\{[^}]*\}/, "", a); c = gsub(/[)}]/, "", a)
      return c > o
    }
    # A file saved with CRLF endings: read each line without its CR, so a trailing backslash still reads as one.
    { sub(/\r$/, "") }
    /^[^#]*set -o pipefail|^[^#]*set -[a-zA-Z]*o pipefail/ { pf = 1 }
    # "a || b" is not a pipe: drop every || before looking for one (a "cmd || sed" fallback was read as "| sed").
    { s = $0; gsub(/\|\|/, "  ", s) }
    s ~ /^[^#]*\| *(tail|head|grep|cut|sed|awk|wc|sort|tr|tee)([[:space:]]|$)/ { p = NR; line = $0 }
    # A "$?" straight after a plain command on its own line is that command'"'"'s status, so a pipe on an EARLIER line
    # cannot reach it (own() above). A pipe on the same line, or a line continued from the pipe'"'"'s, still counts.
    # Nor after a function'"'"'s end: a function whose last command is the pipe returns the filter'"'"'s status, so "fn; rc=..."
    # reads it. "shut" is set by a previous non-blank line holding a closer } or ) as its own word (at its start, or after
    # the last command), or a function definition on one line, or a "function" line.
    p && p != NR && !cont && !shut && own($0) { p = 0 }
    !pf && p && NR - p <= 2 && /\$\?/ && !/PIPESTATUS|pipestatus/ { printf "  line %d: $? after a pipe reads the filter'"'"'s status, not the command'"'"'s: %s\n", NR, line; p = 0 }
    /^[^#]*grep -c[^|]*\|\| *echo 0/ { printf "  line %d: grep -c ... || echo 0 prints two lines when nothing matches: %s\n", NR, $0 }
    # A line ending in a backslash, or in a lone pipe, continues onto the next, so the next line is still the pipeline.
    # Blank and comment-only lines are skipped by both, since a pipeline continues across them.
    /^[[:space:]]*(#.*)?$/ { next }
    # Also "a | tail ||" or "&&": the next line is the fallback, and it reads the filter'"'"'s status.
    { cont = ($0 ~ /\\$/ || s ~ /\|[[:space:]]*$/ || $0 ~ /(\|\||&&)[[:space:]]*$/) }
    # A closer as its own word anywhere on the line ("; }", "} # end", "} 2>/dev/null", "tail -1 )") also ends a body.
    # And any line that closes more ( or { than it opens ("tail -1)" with no space) ends a body begun above.
    { shut = ($0 ~ /^[[:space:]]*[})]/ || $0 ~ /[;[:space:]][})]([[:space:];<>&|#]|$)/ || $0 ~ /\(\)[[:space:]]*[{(]/ || $0 ~ /^[[:space:]]*function[[:space:]]/ || closes($0)) }
  ')"
  # PIPE-LINT-END
  if [ -n "$hits" ]; then
    echo "pre-commit: $f reads the wrong exit status (#632):" >&2
    echo "$hits" >&2
    shape_reds=1
  fi
done
if [ "$shape_reds" -ne 0 ]; then
  echo "  turn on pipefail, read \${PIPESTATUS[0]} on the next line, or redirect to a file and test the command's own status." >&2
  exit 1
fi

# ⚠️ A GUARD THAT CANNOT RUN MUST SAY SO, not report a violation. Without
# node on PATH the test below exits 127 and this hook said "a check and its
# README row must move together" about a commit that moved neither (it did,
# three times in one evening, 2026-08-24, to the person who wrote it). Refuse
# either way, but with the true sentence.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not on PATH, so the browser-checks index guard and the shell-shape scan cannot run. Not a violation: put node on PATH (on this Mac, /opt/homebrew/bin) and commit again." >&2
  exit 1
fi
# --- a screen change runs the guard its checks would fail on (#758) --------
# The page gate is not in yarn test and 15 of its 47 checks were not in the
# gate (first miscounted as 27 of 46; #812), so a change to web/index.html that removes an id a check asks for
# merged green and stopped a cut at minute twenty-two, three times in one
# night. browser-checks-selectors.test.js is the static, milliseconds half:
# every id a check asks for must exist on the page, and the red names the
# check, its line, the id it wanted and the nearest ids the page has. Run
# here whenever the page or a check is staged, so the change that removes
# the id is the change that hears about it.
if git diff --cached --name-only --diff-filter=ACDMR | grep -qE '^web/index\.html$|^docs/browser-checks/'; then
  if ! node --test browser-checks-selectors.test.js >/tmp/kosmos-selectors-hook.$$ 2>&1; then
    echo "pre-commit: a browser check asks web/index.html for an id this change leaves it without (#758). It would go red in the next cut, not in yarn test:" >&2
    grep -E "asks for #|KNOWN_STALE entry" /tmp/kosmos-selectors-hook.$$ | head -8 >&2
    echo "  restate the check to the id that replaced it, or (a check that is stale by ruling) say so on a card and list it in KNOWN_STALE. run: node --test browser-checks-selectors.test.js" >&2
    rm -f /tmp/kosmos-selectors-hook.$$
    exit 1
  fi
  rm -f /tmp/kosmos-selectors-hook.$$
fi
# --- a page change cannot silently undo one of Josh's rulings (#1081) ------
# Item 6 was deleted, landed (e9cb7976), and CAME BACK: a later branch cut
# from a sha before the deletion won the merge. Nothing failed. The suite was
# green either side because no test asserted the sentence's ABSENCE, and the
# commit log still said the work was done.
# An unasserted ruling is not shipped, it is borrowed -- and with ~49 live
# worktrees on this repo, for any unguarded deletion the branch that undoes it
# already exists. That is why he keeps re-reporting things we fixed.
# ⚠️ THE ASSERTIONS EXISTING IS NOT ENOUGH, WHICH IS WHY THIS BLOCK IS HERE.
# There is no CI on this repo, so web.ruling-guards.test.js runs only when
# somebody chooses to run the suite -- and the person merging an old branch is
# exactly the person who does not. Run it where the regression arrives: the
# commit that touches the page.
if git diff --cached --name-only --diff-filter=ACDMR | grep -qE '^web/index\.html$'; then
  if ! node --test web.ruling-guards.test.js >/tmp/kosmos-rulings-hook.$$ 2>&1; then
    echo "pre-commit: this change undoes something Josh ruled on, and the commit log will still say it was done (#1081)." >&2
    grep -E "^ +AssertionError|item [0-9]+|items [0-9]" /tmp/kosmos-rulings-hook.$$ | head -8 >&2
    echo "  if the ruling changed, delete the pin in web.ruling-guards.test.js in the SAME commit and say who changed it." >&2
    echo "  if it did not, you are on a branch older than the fix. run: node --test web.ruling-guards.test.js" >&2
    rm -f /tmp/kosmos-rulings-hook.$$
    exit 1
  fi
  rm -f /tmp/kosmos-rulings-hook.$$
fi
if git diff --cached --name-only --diff-filter=ACDMR | grep -q '^docs/browser-checks/'; then
  # The test reads the working tree, so check what is STAGED: stash nothing,
  # just refuse if an unstaged edit would mask the staged state.
  if ! node --test browser-checks-indexed.test.js >/tmp/kosmos-index-hook.$$ 2>&1; then
    echo "pre-commit: a browser check and its README row must move together (#612)." >&2
    grep -E "not in the README|are not there|browser checks that exist|\+ *\[|'[a-z0-9-]+\.js'" /tmp/kosmos-index-hook.$$ | head -8 >&2
    echo "  run: node --test browser-checks-indexed.test.js" >&2
    rm -f /tmp/kosmos-index-hook.$$
    exit 1
  fi
  rm -f /tmp/kosmos-index-hook.$$
fi
