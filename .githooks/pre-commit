#!/bin/sh
# Refuse a commit that adds, renames or deletes a browser check without the
# README row moving with it (#612). The suite's browser-checks-indexed test
# already asserts this, but a PR can merge green on a subset of the suite and
# leave MAIN red on the next full run; the PR that broke it is then not the PR
# that fails. This runs the one guard, in milliseconds, at the moment the
# change is being made, so the adding change is the one that hears about it.
#
# Wire it once per clone (worktrees inherit it, and the path resolves inside
# each worktree):   git config core.hooksPath .githooks
set -eu
if git diff --cached --name-only --diff-filter=ACDMR | grep -q '^docs/browser-checks/'; then
  # The test reads the working tree, so check what is STAGED: stash nothing,
  # just refuse if an unstaged edit would mask the staged state.
  if ! node --test browser-checks-indexed.test.js >/tmp/kosmos-index-hook.$$ 2>&1; then
    echo "pre-commit: a browser check and its README row must move together (#612)." >&2
    grep -E "not in the README|are not there|browser checks that exist|\+ *\[|'[a-z0-9-]+\.js'" /tmp/kosmos-index-hook.$$ | head -8 >&2
    echo "  run: node --test browser-checks-indexed.test.js" >&2
    rm -f /tmp/kosmos-index-hook.$$
    exit 1
  fi
  rm -f /tmp/kosmos-index-hook.$$
fi
